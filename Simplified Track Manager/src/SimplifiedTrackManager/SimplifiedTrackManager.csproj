<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedTrackManager</RootNamespace>
    <AssemblyName>Simplified Track Manager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off deliberately. Turning it on embeds the native libraries in the
         single file, and the host then extracts them to %TEMP%\.net at startup:
         once per build, never cleaned up, and outside the app folder — which
         this app does not do. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedTrackManager.Core\SimplifiedTrackManager.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
    <Compile Include="..\..\..\Shared\ColourDialog.cs" Link="ColourDialog.cs" />
    <Compile Include="..\..\..\Shared\ScreenColourPicker.cs" Link="ScreenColourPicker.cs" />
    <Compile Include="..\..\..\Shared\FlatButton.cs" Link="FlatButton.cs" />
  </ItemGroup>

  <!-- icon.ico, and texconv.exe, which turns the pictures a user picks into the
       formats the track's own are in. It is a separate process the app
       launches, so it stays a real file; TexconvRunner looks for it in
       runtime\. The same copy the ERP app ships. -->
  <ItemGroup>
    <Content Include="..\..\icon.ico" Link="runtime\icon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
    <Content Include="..\..\..\Simplified ERP\tools\texconv.exe" Link="runtime\texconv.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- Round country flags for the countries the game has none for, from
       flag-icons (MIT), with its licence beside them. See flags\README.md. -->
  <ItemGroup>
    <Content Include="..\..\flags\round\*.png" Link="runtime\flags\round\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
    <Content Include="..\..\flags\LICENSE-flag-icons.txt" Link="runtime\flags\LICENSE-flag-icons.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
      <PublishedNativeLibrary Include="$(PublishDir)x64\*.dll"/>
      <UnusedArchitectureNative Include="$(PublishDir)x86\**\*"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
    <Delete Files="@(UnusedArchitectureNative)"/>
    <RemoveDir Directories="$(PublishDir)x64;$(PublishDir)x86"/>
  </Target>

</Project>
