<Window x:Class="SimplifiedTrackManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SimplifiedUi;assembly=SimplifiedUi"
        Title="Simplified Track Manager"
        UseLayoutRounding="True"
        Width="1040" Height="860" MinWidth="820" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The button that puts a crowd colour back: IconButton drawn small,
             with a circular arrow. A Material icon scaled down to this size
             lands its curves between pixels and comes out warped, so this one is
             drawn at its real size instead, about 10.8px tall, and never
             scaled: a stroked arc running clockwise from the right round
             to the top, and a filled arrowhead there. -->
        <Style x:Key="RestoreButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Canvas Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Arc" Data="M9.7,6 A4.3,4.3 0 1 1 5.4,1.7"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"/>
                                <Path x:Name="Head" Data="M4.9,-0.6 L9.4,1.7 L4.9,4 Z"
                                      Fill="{TemplateBinding Foreground}"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Arc" Property="Stroke" Value="{DynamicResource TextDisabled}"/>
                                <Setter TargetName="Head" Property="Fill" Value="{DynamicResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyed styles inherit nothing unless they say BasedOn, so a keyed
             Button style without one would replace the themed template outright
             and land this window back on the stock look. The TextBlock ones
             carry their own Foreground for the same reason. -->

        <!-- One width for every label column, wide enough for the longest
             label, so the boxes of every section start at the same place. -->
        <GridLength x:Key="LabelWidth">150</GridLength>
        <GridLength x:Key="RightLabelWidth">120</GridLength>

        <!-- A field's label: right-aligned, level with the text in its box. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- A line of explanation under a section heading or a box. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- What the box holds for Spa, under it: a little smaller than a hint
             and in its muted grey, so it reads as an example rather than an
             instruction. Regular weight and clear of the box: a light weight in
             the disabled grey, pressed against the border, couldn't be read.
             The code and initials use the same line for what's wrong with them. -->
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,5,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- A field: its box and the one line under it, with the same space
             below every one, so rows line up across both columns. -->
        <Style x:Key="FieldCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <!-- A section's heading: its title over a thin rule, the same space
             above every section. -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,30,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A group of picture cards inside a section, such as Map. -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
        <!-- The lists as tall as the text boxes beside them, so a row of a
             list and a box lines up. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the name and the caption buttons, nothing else. What the
             app does lives on the bar below. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The caption buttons are declared first, before anything on
                     the left, because a DockPanel hands out space in declaration
                     order and not by side: declared last, they are the first
                     thing to lose it when the window narrows. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>

                <!-- The wordmark and the app's name share a baseline; the pill is
                     a shape and simply centres. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Track Manager"/>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <!-- Which track is loaded, the way Studio names the open project
                     up here. Only one of the two is ever showing. -->
                <TextBlock Name="TrackNameLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,10,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           MinWidth="0" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
                <TextBlock Name="NoTrackLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextDisabled}"
                           Text="No track loaded"/>
            </DockPanel>
        </Border>

        <!-- Action bar: settings on the left, what the app does on the right. -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Name="PackageButton" Content="Package"
                        Padding="16,7" FontWeight="SemiBold" IsEnabled="False"
                        Click="Package_Click"
                        ToolTip="Package the track as a Swofty addon, with its own code, names and pictures"/>

                <Button Name="SettingsButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
            </DockPanel>
        </Border>

        <!-- Form. Every section has the same shape: a heading over a rule,
             then a grid of fields in two columns — label, box, and one line
             under the box — or a grid of picture cards. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Surface}">
            <StackPanel Margin="28,20,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- ── The track ───────────────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Track:"/>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Name="BrowseTrackButton" Content="Browse"
                                    Style="{StaticResource BrowseButton}" Click="BrowseTrack_Click"/>
                            <TextBox Name="TrackBox" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Name="TrackHint" Style="{StaticResource Hint}" Margin="2,6,0,0"
                                   Text="A track zip as the EgoGameDatabasesEditor takes it, or a Swofty track addon — or drop one on the window."/>
                    </StackPanel>
                </Grid>

                <!-- Everything below needs a track, and is hidden until one is loaded. -->
                <StackPanel Name="TrackForm" Visibility="Collapsed">

                    <!-- ── The track ───────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionHeader}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Track"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource RightLabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Name:"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="NameBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Circuit de Spa-Francorchamps"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Author:"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="AuthorBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Codemasters"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Track code:"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="CodeBox" TextChanged="Field_Changed"/>
                            <TextBlock Name="CodeHint" Style="{StaticResource Example}" Text="Spa: spa_francorchamps"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Version:"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="VersionBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Three numbers, such as 1.0.0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Initials:"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="InitialsBox" MaxLength="3" CharacterCasing="Upper" TextChanged="Field_Changed"/>
                            <TextBlock Name="InitialsHint" Style="{StaticResource Example}" Text="Spa: BEL"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Nationality:"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <ComboBox Name="NationalityBox" IsEditable="True"
                                      ToolTip="The track's country: which fans fill the stands"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: belgium"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Difficulty:"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <ComboBox Name="DifficultyBox" IsEditable="True"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Easy"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Aero:"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <ComboBox Name="AeroBox" IsEditable="True"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Low"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Pit lane:"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldCell}">
                            <CheckBox Name="PitMirroredBox" Content="Mirrored" Margin="0,8,0,0"
                                      ToolTip="The pit boxes are on the other side, as at a track that runs anticlockwise"/>
                        </StackPanel>

                        <!-- The three colours as the Grid Editor's team colours
                             are: a card each, swatch, name, hex, and a reset.
                             Set apart with extra space above and below, so they
                             read almost as a section of their own. -->
                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Crowd colours:"
                                   Margin="0,30,12,0"/>
                        <UniformGrid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Name="CrowdPanel" Columns="3"
                                     Margin="0,18,-10,12"/>
                    </Grid>

                    <!-- ── Names ───────────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Written once, shown in every language"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Names"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource RightLabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Country / title:"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="CountryBox" TextChanged="Field_Changed"
                                     ToolTip="What the menus call the track, e.g. Turkey. Left empty, the track's name is used."/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Belgium"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="City:"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="CityBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: Spa-Francorchamps"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Circuit:"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="CircuitBox" CharacterCasing="Upper" TextChanged="Field_Changed"
                                     ToolTip="The circuit's name, in capitals, e.g. ISTANBUL PARK"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: CIRCUIT DE SPA-FRANCORCHAMPS"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="F2 title:"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="F2TitleBox" CharacterCasing="Upper" TextChanged="Field_Changed"
                                     ToolTip="What the F2 menus call the event, e.g. ISTANBUL"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: SPA-FRANCORCHAMPS"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Grand Prix:"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="GrandPrixBox" CharacterCasing="Upper" TextChanged="GrandPrix_Changed"
                                     ToolTip="The short name, e.g. TURKISH GRAND PRIX. The titles follow it until you change them."/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: BELGIAN GRAND PRIX"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Previous title:"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="GrandPrixPreviousBox" CharacterCasing="Upper" TextChanged="Field_Changed"
                                     ToolTip="The title of the last time it was raced"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: FORMULA 1 ROLEX BELGIAN GRAND PRIX 2024"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="2025 title:"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="GrandPrix2025Box" CharacterCasing="Upper" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: FORMULA 1 BELGIAN GRAND PRIX 2025"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="2026 title:"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="GrandPrix2026Box" CharacterCasing="Upper" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: FORMULA 1 BELGIAN GRAND PRIX 2026"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Stats ───────────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionHeader}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Stats"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource RightLabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Length (km):"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="LengthBox" TextChanged="Field_Changed" ToolTip="e.g. 5.338"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: 7.004"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Corners:"/>
                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="CornersBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: 19"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Laps:"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="LapsBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: 44"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Lap record:"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="LapRecordBox" TextChanged="Field_Changed" ToolTip="e.g. 1:24.770"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: 1:44.701"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Holder:"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="LapRecordHolderBox" TextChanged="Field_Changed" ToolTip="e.g. J. P. Montoya (2005)"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: S. Pérez (2024)"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="F2 lap record:"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldCell}">
                            <TextBox Name="F2LapRecordBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: 1:56.054"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="F2 holder:"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Style="{StaticResource FieldCell}">
                            <TextBox Name="F2LapRecordHolderBox" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Example}" Text="Spa: N. De Vries (2018)"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Flags ───────────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Name="InGameFlagsButton" Content="Replace with in game"
                                    Style="{StaticResource BrowseButton}" Click="InGameFlags_Click"
                                    ToolTip="Use one of the game's countries' flags for all three"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Flags"/>
                        </DockPanel>
                    </Border>
                    <!-- Four equal columns that fill the width, so the cards'
                         edges line up with the sections'; the negative margin
                         takes back the gap after the last column. -->
                    <UniformGrid Name="FlagsPanel" Columns="4" Margin="0,0,-12,0"/>

                    <!-- ── Pictures ────────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="A PNG is converted to the size and format each one takes"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Pictures"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Name="PicturesPanel"/>

                    <!-- ── Database ────────────────────────────────────────── -->
                    <!-- What the package carries over from the track that the form
                         doesn't show, as the package writes it: the author's
                         database changes, the ERS, and the manifest's other
                         fields. Read only; it follows the code as it is typed. -->
                    <Border Style="{StaticResource SectionHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Carried over from the track as it is"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Database"/>
                        </DockPanel>
                    </Border>
                    <TextBox Name="DatabaseBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             MaxHeight="460" Padding="8,6" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status, as Studio has it: a line saying what is happening, with
             a turning ring to the left of it. It is only there while the app
             is working, and everything above it is switched off meanwhile —
             see SimplifiedUi.Busy. -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,10"
                Visibility="Collapsed">
            <DockPanel MinHeight="18">
                <ui:Spinner x:Name="StatusSpinner" DockPanel.Dock="Left"
                            VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
