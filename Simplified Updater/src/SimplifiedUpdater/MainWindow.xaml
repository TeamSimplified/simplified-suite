<Window x:Class="SimplifiedUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Updater"
        Width="1180" Height="820" MinWidth="940" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        AllowDrop="True" Drop="Window_Drop">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" Name="ModLabel" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="No mod chosen"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1"
                        Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Name="RecheckButton" Content="Re-check"
                        Padding="12,7" Click="Recheck_Click"
                        ToolTip="Read old\, new\ and the game folder again — after putting new files in one of them"/>

                <Button DockPanel.Dock="Right" Name="UpdateButton" Content="Update"
                        Padding="12,7" Margin="6,0,0,0" FontWeight="SemiBold"
                        IsEnabled="False" Click="Update_Click"
                        ToolTip="Rebuild this mod against the new game files and write it out as a zip"/>
                <Button DockPanel.Dock="Right" Name="ClearLogButton" Content="Clear log"
                        Padding="12,7" Click="ClearLog_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="18,10,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The mod. Labelled, as the ERP app labels the box beside its
                 list: a bare field with a button next to it doesn't say what
                 belongs in it. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Mod"/>
                <TextBox Grid.Column="1" Name="ModBox" IsReadOnly="True"
                         ToolTip="The mod to update — .zip, .7z or .rar. You can also drop one on the window."/>
                <Button Grid.Column="2" Name="BrowseButton" Content="Browse" Padding="12,7"
                        Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>

            <!-- What the run will be built from, and whether it can run at all.
                 These three are the whole basis of the merge, so they are on
                 screen before the button is pressed rather than in the log
                 after it. -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MetaKey}" Text="Game folder"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaVal}" Name="GameDirValue"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MetaKey}" Text="old\"
                               ToolTip="The game's database and language files as the mod found them"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetaVal}" Name="OldValue"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MetaKey}" Text="new\"
                               ToolTip="The same files from the version being updated to"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetaVal}" Name="NewValue"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource SectionHeader}"/>
                <TextBox Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Cascadia Mono"
                         FontSize="12" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
