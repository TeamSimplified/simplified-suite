<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedUpdater</RootNamespace>
    <AssemblyName>Simplified Updater</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off deliberately. Turning it on embeds the native libraries in the
         single file, and the host then extracts them to %TEMP%\.net at startup:
         once per build, never cleaned up, and outside the app folder — which
         this app does not do. They publish as files instead, and
         MoveNativesIntoRuntimeFolder below tidies them away. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedUpdater.Core\SimplifiedUpdater.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <!-- The other half of MoveNativesIntoRuntimeFolder below: nothing looks in a
       subfolder by default, so the app has to say where they went. Linked from
       Shared rather than copied, so every app resolves them the same way — and
       finds the game install the same way. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
  </ItemGroup>

  <!-- Everything the app needs and nobody should be poking at goes in runtime\,
       so what sits beside the exe is the exe, the user's config.json, and the
       two folders of game files they keep current.
       Content items survive PublishSingleFile (None items get stripped);
       ExcludeFromSingleFile keeps them as separate files instead of embedded. -->
  <ItemGroup>
    <Content Include="..\..\icon.ico" Link="runtime\icon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- The two reference folders ship as the note that says what belongs in
       them. old\ is last version's, new\ is this version's.

       A build copies whatever is in them, so an app built from this tree is
       ready to run. A package takes only the notes: the rest is 170 MB of the
       game's own files, and a mod maker downloading this has their own install
       to take them from. The Ships list says the same thing from the other
       side, and a release fails if these ever reach a package. -->
  <ItemGroup>
    <Content Include="..\..\old\README.txt" Link="old\README.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
    <Content Include="..\..\new\README.txt" Link="new\README.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>

    <Content Include="..\..\old\**\*" Exclude="..\..\old\README.txt"
             Link="old\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never"
             ExcludeFromSingleFile="true"/>
    <Content Include="..\..\new\**\*" Exclude="..\..\new\README.txt"
             Link="new\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
      <PublishedNativeLibrary Include="$(PublishDir)x64\*.dll"/>
      <UnusedArchitectureNative Include="$(PublishDir)x86\**\*"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
    <Delete Files="@(UnusedArchitectureNative)"/>
    <RemoveDir Directories="$(PublishDir)x64;$(PublishDir)x86"/>
  </Target>

</Project>
