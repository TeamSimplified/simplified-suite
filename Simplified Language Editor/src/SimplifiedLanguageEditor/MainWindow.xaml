<Window x:Class="SimplifiedLanguageEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Language Editor"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" Name="LogRow"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows. The margin below is the baseline correction — the
                     mark's box carries the descender of its "p", and a margin
                     against a centred element moves it by half. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Language Editor"/>

                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <!-- The open file, beside the mark, as every other app in the
                     suite has it. Text is not hit-test-visible in the chrome, so
                     dragging the window still works across it. MaxWidth sits on
                     the label rather than the panel: a horizontal StackPanel
                     measures its children unconstrained, and trimming needs a
                     width to trim to. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Name="FilePathLabel" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabled}"
                               TextTrimming="CharacterEllipsis" MaxWidth="460"
                               Text="No file open"/>
                    <TextBlock Name="DirtyLabel" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                               Text="unsaved changes" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1"
                        Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Name="NewButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconNew}" Click="New_Click"
                        ToolTip="A blank language file, with the game's own hash settings"/>
                <Button DockPanel.Dock="Left" Name="OpenButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconOpen}" Click="Open_Click" Margin="6,0,0,0"
                        ToolTip="Open a .lng    (Ctrl+O)"/>
                <!-- Save as, not Save: what is open is the game's own file, and
                     the suite's rule is that the icon never writes over a master
                     copy. Ctrl+S still overwrites in place. -->
                <Button DockPanel.Dock="Left" Name="SaveAsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSave}" Click="SaveAs_Click" Margin="6,0,0,0"
                        IsEnabled="False" ToolTip="Save as…    (Ctrl+S overwrites the open file)"/>

                <Border DockPanel.Dock="Left" Margin="10,0" Width="1"
                        Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Name="MergeOverwriteButton" Content="Merge + overwrite"
                        Padding="12,7" IsEnabled="False" Click="MergeOverwrite_Click"
                        ToolTip="For each key in the picked file: replace the value if it is here, add it if it is not"/>
                <Button DockPanel.Dock="Left" Name="MergePreserveButton" Content="Merge + preserve"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False" Click="MergePreserve_Click"
                        ToolTip="For each key in the picked file: add it only if it is not here already"/>
                <Button DockPanel.Dock="Left" Name="CompareButton" Content="Compare"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False" Click="Compare_Click"
                        ToolTip="Write out what this file says differently from another one: the lines whose text has changed, and the lines it adds"/>

                <!-- Close is the file, not the app: the window's own X shuts the
                     app, and a second button doing that would sit beside one
                     that doesn't. Right-docked, so the first declared sits
                     furthest right — and the gap between two is the right-hand
                     one's left margin. -->
                <Button DockPanel.Dock="Right" Name="CloseFileButton" Content="Close"
                        Padding="12,7" IsEnabled="False" Click="CloseFile_Click"
                        ToolTip="Close the open file"/>
            </DockPanel>
        </Border>

        <!-- Filter and row actions -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Name="DeleteButton" Content="Delete selected"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False" Click="Delete_Click"/>
                <Button DockPanel.Dock="Right" Name="AddButton" Content="Add row"
                        Padding="12,7" IsEnabled="False" Click="Add_Click"
                        ToolTip="Add an entry    (Ctrl+N)"/>

                <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock DockPanel.Dock="Right" Name="CountLabel" VerticalAlignment="Center"
                           Margin="14,0,14,0" Foreground="{DynamicResource TextMuted}"/>
                <TextBox Name="FilterBox" TextChanged="Filter_Changed" MaxWidth="420"
                         HorizontalAlignment="Left" MinWidth="260"/>
            </DockPanel>
        </Border>

        <!-- The table. No styles of its own: DataGrid, its headers, rows and
             cells are templated in the shared theme, where the Driver Swapper
             put them when it became the first app in the suite with a table. -->
        <!-- No border and no margin: the table is the window from the filter
             bar down. A framed box inside a frame spends two edges and a gutter
             saying where a thing starts, which the bar above it has already
             said. The 18 everything else in the window keeps is in the cells
             instead, so the first column still lines up with Filter. -->
        <DataGrid Grid.Row="3" Name="EntryGrid" Margin="0"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  Background="Transparent"
                  CellStyle="{StaticResource RoomyCell}"
                  ColumnHeaderStyle="{StaticResource RoomyHeader}"
                  AlternationCount="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="True" CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                  BeginningEdit="EntryGrid_BeginningEdit"
                  CellEditEnding="EntryGrid_CellEditEnding"
                  SelectedCellsChanged="EntryGrid_SelectedCellsChanged"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <!-- EditingElementStyle, or the box a double-click opens is
                     WPF's own: white with black text, because the column builds
                     it from a style that has no BasedOn and so replaces the
                     themed one. The style is in the shared theme, where the next
                     app with an editable table will find it. -->
                <!-- The key does not wrap: they are one word with underscores,
                     and a key broken across two lines is harder to read than one
                     that is a little too long for its column.

                     The widths here are only what the table looks like before it
                     is laid out: the window sets them from the saved split, and
                     puts them back as stars whenever a header is dragged. -->
                <DataGridTextColumn Header="Key" Width="2*"
                                    HeaderStyle="{StaticResource RuledHeader}"
                                    Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                    EditingElementStyle="{StaticResource DataGridEditor}"/>
                <DataGridTextColumn Header="Value" Width="3*"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource WrappedCell}"
                                    EditingElementStyle="{StaticResource WrappedEditor}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- The log, off unless Settings says otherwise. Height on the panel
             rather than on the row: a collapsed panel in an Auto row takes no
             space at all, so the table grows into it without the row having to
             be resized as well. -->
        <DockPanel Grid.Row="4" Name="LogPanel" Height="150" Margin="18,12,18,18"
                   Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource SectionHeader}"/>

            <!-- The shared TextBox style centres its content, which is right for
                 a one-line field and wrong for a page of writing. -->
            <TextBox Name="LogBox" IsReadOnly="True"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas, Cascadia Mono"
                     FontSize="12" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
        </DockPanel>
    </Grid>
</Window>
