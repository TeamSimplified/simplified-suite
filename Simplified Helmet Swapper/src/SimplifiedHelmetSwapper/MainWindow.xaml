<Window x:Class="SimplifiedHelmetSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Helmet Swapper"
        Width="900" Height="620" MinWidth="700" MinHeight="480"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Keyed styles inherit nothing unless they say BasedOn, so a keyed
             Button style without one would replace the themed template outright
             and land this window back on the stock look. The TextBlock ones
             carry their own Foreground for the same reason. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <!-- Top, not centre: a field whose hint wraps to three lines would
                 otherwise drag its label away from the box it names. -->
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar. Above the toolbar so the window's Close can't be mistaken
             for the Swap button a row below. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Simplified Helmet Swapper"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandInk}"/>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Settings" Padding="14,6" Click="Settings_Click"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1" Background="{DynamicResource BorderSoft}"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold" Text="Helmet swap"/>

                <Button DockPanel.Dock="Right" Name="SwapButton" Content="Swap" Padding="22,6"
                        FontWeight="SemiBold" IsEnabled="False" Click="Swap_Click"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 the helmet being taken -->
                <RowDefinition Height="Auto"/>  <!-- 1 who will wear it -->
                <RowDefinition Height="Auto"/>  <!-- 2 output -->
                <RowDefinition Height="*"/>     <!-- 3 what the swap did -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Helmet"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="HelmetBox" HorizontalAlignment="Left" MinWidth="320" MaxWidth="460"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="HelmetHint" Style="{StaticResource Hint}"
                           Text="The helmet you want to use — shell, attachments, visor and paint."/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Worn by"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="WearerBox" HorizontalAlignment="Left" MinWidth="320" MaxWidth="460"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="WearerHint" Style="{StaticResource Hint}"
                           Text="The driver who will wear it. Their own helmet is replaced."/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Save to"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource BrowseButton}"
                            Click="BrowseOutput_Click"/>
                    <TextBox Name="OutputBox" TextChanged="Output_Changed"/>
                </DockPanel>
                <TextBlock Name="OutputHint" Style="{StaticResource Hint}"
                           Text="A full replacement for the wearer&apos;s own _helmet.erp, with the helmet swapped in."/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pieces"/>
            <DockPanel Grid.Row="3" Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Name="PiecesHint" Style="{StaticResource Hint}"
                           Margin="0,0,0,4"
                           Text="Press Swap to take the helmet apart and rebuild it."/>
                <ListBox Name="PiecesList" Background="{DynamicResource SurfaceSunken}"
                         FontFamily="Consolas" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
