<Window x:Class="SimplifiedLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simplified Launcher"
        Width="420" Height="760"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"

        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"

        ><!-- The three that make a window its own shape: no frame from Windows,
             a transparent window so the corners outside the radius show
             nothing, and no resize so there is no border to grab. The rounding
             is then drawn rather than asked for, which is the only way to pick
             the radius. -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
        </Style>
    </Window.Style>

    <Window.Resources>

        <!-- The list. A ListBox for the selection behaviour and the keyboard,
             with everything it draws by default replaced: no border, no
             highlight, no alternating anything. What marks a row as chosen is
             the block to the left of it going from dark grey to white, which
             is the whole of the visual language here. -->
        <Style x:Key="Marker" TargetType="Border">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>

        <!-- The right-click menu on a row. Windows' own is grey, square and
             from another decade, so all of it is replaced: the popup
             border, the item, the check column and the arrow column that
             take up space whether or not anything uses them.

             HasDropShadow off and a plain border instead ~ the system
             shadow is drawn outside the popup and does not know about the
             corner radius, so it shows up as a grey square behind the
             rounded one. -->
        <Style x:Key="RowMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontFamily" Value="Outfit"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemPad"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,7">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemPad" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowMenu" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1C1C1C"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowMenuItem}"/>
        </Style>

        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- MouseRightButtonDown is swallowed here so a right
                             click does not also tick the row. ListBoxItem
                             selects on the right button as well as the left,
                             which with a multi-select list means opening a menu
                             would quietly change what Play is about to run.

                             The bubbling event, not the preview one: it travels
                             outwards from here to the ListBoxItem, so marking it
                             handled at this border is what stops the item ever
                             seeing it. Preview would arrive at the item first and
                             be too late. Only the down event is taken — the menu
                             itself opens on the way back up. -->
                        <Border x:Name="RowPad" Background="Transparent" CornerRadius="8" Padding="10,9"
                                MouseRightButtonDown="Row_MouseRightButtonDown">

                            <!-- On the row rather than on the list: a menu
                                 belonging to the list would have to work out
                                 which mod was meant, and this border's
                                 DataContext already is that mod.

                                 Inside the template rather than in a Setter on
                                 the style above. A Setter's value is one shared
                                 object and the markup compiler will not wire an
                                 event handler into it; a template is compiled per
                                 instance and will. -->
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource RowMenu}">
                                    <MenuItem Header="Delete" Click="DeleteMod_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Marker" Style="{StaticResource Marker}"/>
                                <TextBlock x:Name="Label"
                                           Text="{Binding Name}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Outfit"
                                           FontWeight="Medium"
                                           FontSize="15"
                                           Foreground="#C8C8C8"/>

                                <!-- Who made it and which one it is, a size
                                     down and several shades back, so the row
                                     still reads as its name first. These two
                                     do not brighten with selection: the point
                                     of a quiet colour is lost if it only stays
                                     quiet while unchosen. -->
                                <TextBlock Text="{Binding Author}"
                                           Margin="10,1,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Outfit"
                                           FontWeight="Regular"
                                           FontSize="12"
                                           Foreground="#6B6B6B"/>

                                <!-- No v put in front of it. The version is
                                     whatever the mod's own manifest says, and
                                     an author who wrote "1.6" meant 1.6 while
                                     one who wrote "v1.6" would otherwise get
                                     vv1.6. The suite packages under the same
                                     rule: the version goes on verbatim. -->
                                <TextBlock Text="{Binding Version}"
                                           Margin="8,1,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Outfit"
                                           FontWeight="Regular"
                                           FontSize="12"
                                           Foreground="#6B6B6B"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowPad" Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="Marker" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <!-- Selection last, so it wins over the hover tint
                                 on the row the pointer is already on. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Marker" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A three pixel track, because the stock scrollbar is seventeen
             pixels of grey furniture and would be the loudest thing in the
             window. It only appears while there is something to scroll.

             Handed to the bar by name from a ScrollViewer template of our
             own, below. Two goes at this with an implicit style — once inside
             the ScrollViewer, once at the window — both missed, because the
             bar is built inside the ScrollViewer's template and an implicit
             style from outside does not reach in there. Nothing errors when
             it misses; the stock bar simply stays.

             The thumb's radius is half its width, which is as round as a bar
             this thin can be, and it is brighter than a wider one would need
             to be because there is so little of it. -->
        <Style x:Key="Slim" TargetType="ScrollBar">
            <!-- MinWidth as well as Width, and it is the one that matters.
                 The theme sets MinWidth to the system scrollbar width, and a
                 minimum is a layout constraint rather than a competing value
                 — it wins over Width whatever the style precedence says. Set
                 Width alone and the bar measures 2 and lays out at 17. -->
            <Setter Property="Width" Value="3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4DFFFFFF" CornerRadius="1.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scroll chrome, named once and used by both lists. It was
             written inline in the mod list; a second list meant either a
             second copy of it or this. -->
        <ControlTemplate x:Key="Scroller" TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1"
                                           Orientation="Vertical"
                                           Style="{StaticResource Slim}"
                                           Minimum="0"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{Binding VerticalOffset, Mode=OneWay,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            </Grid>
                                </ControlTemplate>

        <!-- Settings rows are not a list you pick from. They will be
             toggles, buttons, and a box with a browse beside it — things you
             operate, not things you choose between. An ItemsControl has no
             selection to get in the way of that, where a ListBox would
             highlight whatever you last touched, move that highlight with
             the arrow keys, and take the click before the control inside
             the row saw it.

             Same scroll chrome and the same padding as the mod list, so the
             two pages sit identically. -->
        <!-- The small label: STATUS over the heading, and the name over each
             group of settings. One style so the size and the colour cannot
             drift apart; the weight is set where it is used, because STATUS
             is Light and the settings labels are Regular.

             Display formatting, against the headline's Ideal: at twelve
             pixels snapping the stems to whole pixels is what keeps a light
             grey from turning to mush. -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Outfit"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- A choice of two, side by side. RadioButton rather than a plain
             toggle: Steam or the EA App, AMD or not — these are one answer
             each, and two independent switches could be left saying both or
             neither. GroupName is what keeps each pair to one.

             White means chosen, the same as the markers in the mod list, so
             the text goes to the window colour to stay readable on it.

             Checked is declared after hover so it wins on a chip the pointer
             is already over, and the pair of them after that so a chosen
             chip still answers the pointer. -->
        <!-- folder_open, Material Icons e2c8, filled. The path is verbatim
             from google/material-design-icons at
             src/file/folder_open/materialicons/24px.svg, and e2c8 is that
             name in MaterialIcons-Regular.codepoints. Written out as
             geometry like the other two icons: nothing to install, and
             nothing to fall back from.

             Material ships a transparent M0 0h24v24H0z square ahead of it
             to hold the box at 24; a Viewbox does that job here, so it is
             left out rather than drawn and hidden.

             The hollow body is the icon, not a mistake. In this, the older
             set, filled folder_open is a folder seen open from the side,
             and the inner rectangle is wound the other way so nonzero
             punches it through. The newer Material Symbols draw the same
             name solid, with the front panel skewed. -->
        <Geometry x:Key="Folder">F1 M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z</Geometry>

        <!-- A field, at the same tenth of white the window buttons use for
             their hover pad. TextBox has no corner radius of its own, so the
             template puts one in and the content host sits inside it. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#59FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Outfit"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The button beside it. The same fill and the same height as the
             field, so the two read as one control rather than a box with
             something next to it. -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pad"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pad" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pad" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Outfit"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pad"
                                Background="#14FFFFFF"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pad" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pad" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0E0E0E"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pad" Property="Background" Value="#E6E6E6"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Rows" TargetType="ItemsControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False"
                                      Padding="0,8"
                                      VerticalScrollBarVisibility="Auto"
                                      Template="{StaticResource Scroller}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="List" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Row}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <!-- The ScrollViewer's own template, so the bar can
                             be handed its style by name. Left to its default
                             template the bar is built inside it, where an
                             implicit style declared out here never reaches it
                             and Windows' seventeen pixel one stays. -->
                        <ScrollViewer Focusable="False"
                                      Padding="0,8"
                                      VerticalScrollBarVisibility="Auto"
                                      Template="{StaticResource Scroller}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Team Simplified mark, from the same Asset 13.svg the
             launcher lockup came out of — the file was replaced between
             the two, so these are two different drawings that happen to
             have shared a name. Fourteen shapes merged into one
