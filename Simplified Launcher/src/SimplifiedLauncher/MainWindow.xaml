                                                             To="0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Without this a disabled button looks exactly
                                 like a live one: the default greying comes
                                 from the stock template, which this replaces.
                                 Animated rather than set, so it dims and
                                 lifts instead of blinking, and the hand goes
                                 away with it. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.25" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
         <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

   </Window.Resources>

    <!-- The window's whole surface, and the whole of its shape. -->
    <Border x:Name="Surface"
            Background="#0E0E0E"
            CornerRadius="16"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Grid>

        <!-- The gradient: five soft points rather than one ramp, which is
             what gives it the blurred look. Each is a radial brush with a
             gentle falloff — no BlurEffect, which on a transparent window
             costs more than it is worth and reads much the same.

             Three things are deliberate and none is obvious:

               * every point fades out to its own colour at zero alpha, not to
                 transparent black. Fading a colour to #00000000 drags the
                 midtones grey and the whole thing turns muddy. The black point
                 is the one case where the two are the same thing;
               * each point is a full-bleed Border carrying the surface's own
                 corner radius. A plain rectangle in here would paint over the
                 rounded corners and square them off, and the clip that would
                 otherwise be needed has to be told a size;
               * the drift animates where each brush is centred, not where its
                 Border sits. Moving the Borders would move the rounded corners
                 with them and open gaps at the edge of the window; moving the
                 light inside them leaves the shape alone.

             Each point wanders near its own corner rather than travelling
             far: enough that the window is never quite still, not enough to
             change where anything is. The periods are unequal and no one of
             them divides another, so they stay out of phase instead of
             pulsing together. Thirty frames a second is plenty at this speed
             and halves the painting.

             The colour is deliberately thin. What makes a wash of light read
             as glass rather than as a blob is the absence of a hot centre, so
             none of these starts at full: the core is around three quarters
             and falls away fast, and the spreads are wide enough that what is
             left is spread over most of the window.

             No BlurEffect. A radial falloff this soft has no edge for a blur
             to find, and it would cost real work every frame on a window that
             already carries per-pixel alpha.

             Order is paint order, which is why both blacks come last: they
             darken what is under them rather than being lit over. The azure
             sits over the green, so the middle of the window takes a teal
             where the two overlap rather than either colour winning.

             The azure is at a third of the alpha the others carry. It is
             there to tint the gap between the purple and the green, not to be
             a colour of its own — at anything more it reads as a fourth blob
             instead of the place where two of them meet.

             The opacity is on the group, so the points blend with each other
             at full strength and only the result is dimmed. One number for the
             weight of the whole thing. -->
        <Grid Opacity="0.15" IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="30">



                            <PointAnimation Storyboard.TargetName="Indigo"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.Center)"
                                            From="0.22,0.18" To="0.36,0.27"
                                            Duration="0:0:8"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="Indigo"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.GradientOrigin)"
                                            From="0.22,0.18" To="0.36,0.27"
                                            Duration="0:0:8"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="GreenLow"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.Center)"
                                            From="0.86,0.91" To="0.70,0.82"
                                            Duration="0:0:7"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="GreenLow"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.GradientOrigin)"
                                            From="0.86,0.91" To="0.70,0.82"
                                            Duration="0:0:7"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="Shade"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.Center)"
                                            From="0.02,0.73" To="0.18,0.62"
                                            Duration="0:0:11"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="Shade"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.GradientOrigin)"
                                            From="0.02,0.73" To="0.18,0.62"
                                            Duration="0:0:11"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>







                            <PointAnimation Storyboard.TargetName="Azure"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.Center)"
                                            From="0.54,0.55" To="0.64,0.47"
                                            Duration="0:0:9"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="Azure"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.GradientOrigin)"
                                            From="0.54,0.55" To="0.64,0.47"
                                            Duration="0:0:9"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="ShadeTop"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.Center)"
                                            From="0.92,0.10" To="0.80,0.20"
                                            Duration="0:0:13"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                            <PointAnimation Storyboard.TargetName="ShadeTop"
                                            Storyboard.TargetProperty="Background.(RadialGradientBrush.GradientOrigin)"
                                            From="0.92,0.10" To="0.80,0.20"
                                            Duration="0:0:13"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                <PointAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </PointAnimation.EasingFunction>
                            </PointAnimation>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>


            <!-- purple, the top left, in off the edge -->
            <Border x:Name="Indigo" CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.22,0.18" GradientOrigin="0.22,0.18"
                                         RadiusX="1.44" RadiusY="0.74">
                        <GradientStop Offset="0"    Color="#B8353ADF"/>
                        <GradientStop Offset="0.45" Color="#60353ADF"/>
                        <GradientStop Offset="0.72" Color="#28353ADF"/>
                        <GradientStop Offset="1"    Color="#00353ADF"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- green again, the bottom right, and the quieter of the two: it
                 keeps this slot's smaller spread so the corner does not shout,
                 but takes the shared FF/8C rather than the alpha azure was held
                 down to. That cut was for azure being the brightest thing in
                 the gradient, and green is nowhere near it. -->
            <Border x:Name="GreenLow" CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.86,0.91" GradientOrigin="0.86,0.91"
                                         RadiusX="1.22" RadiusY="0.62">
                        <GradientStop Offset="0"    Color="#B800AD2F"/>
                        <GradientStop Offset="0.45" Color="#5E00AD2F"/>
                        <GradientStop Offset="1"    Color="#0000AD2F"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- azure, between the purple and the green, barely there -->
            <Border x:Name="Azure" CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.54,0.55" GradientOrigin="0.54,0.55"
                                         RadiusX="1.02" RadiusY="0.54">
                        <GradientStop Offset="0"    Color="#5006BAFE"/>
                        <GradientStop Offset="0.45" Color="#2606BAFE"/>
                        <GradientStop Offset="1" Color="#0006BAFE"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- black, the left, lower down -->
            <Border x:Name="Shade" CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.02,0.73" GradientOrigin="0.02,0.73"
                                         RadiusX="1.14" RadiusY="0.58">
                        <GradientStop Offset="0"    Color="#C0000000"/>
                        <GradientStop Offset="0.45" Color="#66000000"/>
                        <GradientStop Offset="1"    Color="#00000000"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- black, the top right -->
            <Border x:Name="ShadeTop" CornerRadius="16">
                <Border.Background>
                    <RadialGradientBrush Center="0.92,0.10" GradientOrigin="0.92,0.10"
                                         RadiusX="1.02" RadiusY="0.54">
                        <GradientStop Offset="0"    Color="#C0000000"/>
                        <GradientStop Offset="0.45" Color="#66000000"/>
                        <GradientStop Offset="1" Color="#00000000"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

        </Grid>

        <!-- The wordmark and its label, on both middles of the window: the
             group is centred, and its lines are flush left against each other
             inside it. So the mark, STATUS and CHOOSE all start where YOUR
             MODS starts, and the block sits in the middle together — which is why there is no
             margin on the group. A margin on one side of a centred element
             moves it off centre by half of itself.
             
             Outfit Bold is installed on this machine, so the family is named
             rather than carried. Worth knowing if this ever leaves here: a
             machine without it falls back silently and the whole look goes
             with it, and the fix is to put the .ttf in the project and
             reference it as a pack URI instead.

             LineHeight needs BlockLineHeight beside it or it is ignored. It is
             kept at about 0.87 of the size, so the two lines sit much closer
             than the font's own leading — which all-caps can take, because
             there is nothing below the baseline to collide. Change the size
             and this wants changing with it.

             Ideal rather than the window's Display formatting: Display snaps
             stems to whole pixels, which keeps small UI text crisp and makes
             type this size sit unevenly. -->
        <DockPanel Margin="0,62,0,0">

        <StackPanel x:Name="Heading"
                    DockPanel.Dock="Top"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False">
            <!-- The whole heading travels together — mark, label and
                 the stacked line — and a render transform is what
                 moves it. Animating a margin instead would re-run the
                 layout every frame.

                 Vertical only. Sideways it is pinned, once, in code:
                 see Anchor. -->
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="HeadingShift"/>
            </StackPanel.RenderTransform>

            <!-- The lockup, above and apart. Set by height rather than
                 width, so it scales with the type beside it.

                 34 where the old mark was 23: that one was a single word and
                 this is two lines, so the same height would have halved
                 each of them. At 34 it draws about 148 wide, which is near
                 enough the old mark's 113 to sit in the same place without
                 the block growing round it — matching cap height is what makes a mark sit level
                 with type rather than merely near it.

                 The 24 below it against the 6 under STATUS is the whole point
                 of the spacing: a gap four times the other reads as a break,
                 so STATUS and the two lines under it group into one thing and
                 this stands apart from them. -->
            <Viewbox Height="34"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,24"
                     Stretch="Uniform">
                <Path Data="{StaticResource Wordmark}" Fill="#FFFFFF"/>
            </Viewbox>

            <!-- Display formatting here, against the wordmark's Ideal: at
                 this size snapping the stems to whole pixels is what keeps a
                 light grey from turning to mush, and the uneven spacing it
                 causes is too small to see. The two settings are right for
                 opposite reasons.

                 The panel is as wide as its widest line, so left-aligning both
                 children puts this flush with MILDTDESIGN. -->
            <TextBlock Text="STATUS"
                       Style="{StaticResource Label}"
                       FontWeight="Light"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,6"/>

            <TextBlock x:Name="Headline"
                       HorizontalAlignment="Left"
                       FontFamily="Outfit"
                       FontWeight="Bold"
                       FontSize="32"
                       LineHeight="28"
                       LineStackingStrategy="BlockLineHeight"
                       TextAlignment="Left"
                       Foreground="#FFFFFF"
                       TextOptions.TextFormattingMode="Ideal">
CHOOSE<LineBreak/>YOUR MODS</TextBlock>

        </StackPanel>

        <!-- The list, filling whatever is left under the heading. Its side
             margins are 22, the measure the buttons use, and the row template
             pads another 10 inside that — so the marker blocks line up on 32
             and the row's own hover tint has somewhere to show.

             Multiple rather than Extended: Extended is the Explorer
             behaviour, where a plain click clears everything else and you
             need a modifier held down to keep it. Multiple makes each click a
             toggle, which is what picking a set of mods is.

             SelectedIndex starts at nothing: a list that chooses for you has
             already answered the question it is asking.

             More rows than fit, so the thing is actually scrollable rather
             than merely able to be. The eight pixels of padding are inside
             the ScrollViewer, so the first and last rows pass under them
             instead of being pinned clear of the edge.

             The 120 at the bottom is held open for whatever goes there next,
             so the list ends well short of the window. -->
        <!-- Both lists live here, one on top of the other. In a
             DockPanel they would sit side by side instead: everything
             docked takes its own strip and only the last child fills
             what is left. -->
        <Grid>

        <ListBox x:Name="Mods"
                 Style="{StaticResource List}"
                 Margin="22,34,16,120"
                 SelectionMode="Multiple"
                 SelectionChanged="Mods_SelectionChanged"
                 SelectedIndex="-1"/>

        <!-- Settings, empty until there is something to put in it. The
             rows will each hold their own control, so this one does not
             select — see the Rows style.

             Starts at nothing and takes no clicks: an empty list at
             zero opacity is still a thing the pointer can land on. -->
        <ItemsControl x:Name="Options"
                      Style="{StaticResource Rows}"
                      Margin="22,34,16,170"
                      Opacity="0"
                      IsHitTestVisible="False">

            <!-- The 10 down the left is the same padding a mod row
                 gives itself, so these labels start where the markers
                 do and the two pages share an edge. -->
            <!-- Two up from the prose below it and bold, so the page
                 opens by saying which launcher this is. -->
            <TextBlock Text="v4.0.00"
                       Style="{StaticResource Label}"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#FFFFFF"
                       Margin="10,0,10,10"/>

            <!-- The group labels' font and size, in white and in
                 sentence case. It reads as the same voice as PLATFORM
                 and GPU rather than as a heading over them, which is
                 what it is: the page explaining itself.

                 Two points up from the labels, and the leading with it:
                 20 on 14 holds the same ratio 17 on 12 did. The labels are
                 one word each and never show their leading, where three
                 lines of prose at the font's own would set too tight. -->
            <TextBlock Style="{StaticResource Label}"
                       FontWeight="Regular"
                       FontSize="14"
                       Foreground="#FFFFFF"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       Margin="10,0,10,24"
                       Text="These settings are used to install and launch the mods you want to use correctly. When you import a mod that mod will be optimized to work with your game."/>

            <!-- The game folder. A label over it like the groups below,
                 which was not asked for — but every other thing on this
                 page names itself, and a bare box above PLATFORM would be
                 the only one that did not. -->
            <StackPanel Margin="10,0,10,20">
                <TextBlock Text="GAME DIRECTORY"
                           Style="{StaticResource Label}"
                           FontWeight="Regular"/>
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="GameDir"
                             Grid.Column="0"
                             Style="{StaticResource Field}"/>

                    <Button Grid.Column="1"
                            Margin="7,0,0,0"
                            Style="{StaticResource FieldButton}"
                            Click="Browse_Click"
                            ToolTip="Choose the game folder">
                        <Path Data="{StaticResource Folder}"
                              Stretch="Uniform"
                              Width="17" Height="17"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Platform -->
            <StackPanel Margin="10,0,10,20">
                <TextBlock Text="PLATFORM"
                           Style="{StaticResource Label}"
                           FontWeight="Regular"/>
                <!-- Click rather than Checked, on both. Checked also fires when
                     the code sets IsChecked — including the one below, during
                     InitializeComponent — so a Checked handler could not tell a
                     person's choice from the app's own. Click only comes from a
                     mouse or the keyboard, which is exactly the difference that
                     matters here. -->
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <RadioButton x:Name="PlatformSteam"
                                 Content="Steam"
                                 Style="{StaticResource Chip}"
                                 GroupName="Platform"
                                 Click="Platform_Click"
                                 IsChecked="True"/>
                    <RadioButton x:Name="PlatformEa"
                                 Content="EA App"
                                 Style="{StaticResource Chip}"
                                 GroupName="Platform"
                                 Click="Platform_Click"
                                 Margin="7,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Gpu -->
            <StackPanel Margin="10,0,10,20">
                <TextBlock Text="GPU"
                           Style="{StaticResource Label}"
                           FontWeight="Regular"/>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <RadioButton x:Name="GpuAmd"
                                 Content="AMD"
                                 Style="{StaticResource Chip}"
                                 GroupName="Gpu"
                                 Click="Gpu_Click"
                                 IsChecked="True"/>
                    <RadioButton x:Name="GpuOther"
                                 Content="Other"
                                 Style="{StaticResource Chip}"
                                 GroupName="Gpu"
                                 Click="Gpu_Click"
                                 Margin="7,0,0,0"/>
                </StackPanel>
            </StackPanel>

        </ItemsControl>

        </Grid>

        </DockPanel>

        <!-- Play, from Google's Material Symbols: the filled play_arrow,
             whose whole geometry is "M 8,5 V 19 L 19,12 Z" on a 24 square.
             Drawn rather than pulled from an icon font, so there is nothing
             to install and nothing to fall back from.

             Moved to start at the origin, which matters more than it looks.
             A Path measures as the bounds of its geometry counted from 0,0,
             so the 8 and the 5 Google's version starts at were measured as
             part of the shape — the Viewbox scaled a 19 by 19 box with the
             triangle in the corner of it, and the glyph sat low and right of
             the middle of the button. Starting at 0,0 makes the Viewbox fit
             the triangle and nothing else.

             The height here is therefore the height of the shape on screen
             and not of any padding around it.

             Sitting in the room held open at the bottom of the list, on the
             window's middle. The box stays 44 while the glyph came down to
             18, so the hit area is unchanged and only the triangle shrank.

             Same family as the close and minimise buttons, by BasedOn, so the
             hover pad matches them without being described twice. White at
             rest instead of grey, because this one is what the window is for
             rather than a window control — which does mean the hover shows in
             the pad alone, the glyph having nowhere brighter to go. -->
        <!-- The team mark, sitting just over the button that closes
             settings rather than anywhere in the page: it belongs to
             the window, not to the list of options. Twenty-six pixels
             above the button and thirty-two below the list — nearer the
             button of the two, which is what keeps it reading as part of
             the bottom rather than as the last row of the page.

             It comes and goes with the settings page, so it fades
             with everything else and takes no clicks while hidden. -->
        <Viewbox x:Name="TeamSlot"
                 Height="28"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="0,0,0,110"
                 Stretch="Uniform"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Path Data="{StaticResource TeamMark}" Fill="#FFFFFF"/>
        </Viewbox>

        <!-- The bottom row, and what hides it. Being switched off and
             being out of the picture both want to fade, and both would
             want the same Opacity — so one of them has to belong to
             something else, or the two animations fight over the property
             and the last one to run wins. The buttons keep their own
             opacity for being disabled; this row owns being gone.

             Both buttons are 44 tall and sit on the row, so they share a
             middle without either being told where it is. -->
        <Grid x:Name="BottomBar"
              VerticalAlignment="Bottom"
              Margin="0,0,0,40">

            <!-- Left edge of the glyph on the marker bars, not on the list
                 box: the markers are what you actually see down that side.
                 They sit at 32, the list's own 22 plus the 10 a row pads
                 itself by, and 13 of that comes off again because the glyph
                 is 18 inside a 44 box. -->
            <!-- Each of the three has a holder, and for the reason the
                 row itself has one: a button's own Opacity belongs to
                 whether it is switched off. Fading one in or out of the
                 picture has to happen somewhere else or the two
                 animations fight over the property. -->
            <Grid x:Name="SettingsSlot" HorizontalAlignment="Left" Margin="19,0,0,0">
                <Button x:Name="Settings"
                        Style="{StaticResource BareButton}"
                        Click="Settings_Click"
                        ToolTip="Settings">
                    <Path Data="{StaticResource Gear}"
                          Stretch="Uniform"
                          Width="18" Height="18"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
            <Grid x:Name="PlaySlot" HorizontalAlignment="Center">
            <Button x:Name="Play"
                    Style="{StaticResource PlayButton}"
                    Click="Play_Click"
                    ToolTip="Launch">
            <Viewbox Height="18" Stretch="Uniform">
                <!-- A hair to the right, and it is not a fudge. A triangle
                     pointing right carries its weight against the flat edge:
                     its centroid is a third of the way across while the box
                     it sits in has its middle at a half, so a play glyph
                     centred by its bounds always reads as sitting left. Every
                     icon set nudges it. Set X to 0 for true bounds centring. -->
                <Viewbox.RenderTransform>
                    <TranslateTransform X="1.5"/>
                </Viewbox.RenderTransform>
                <Path Data="M 0,0 V 14 L 11,7 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Viewbox>
            </Button>
            </Grid>

            <!-- Where play was, for coming back out. Starts at nothing, and
                 out of the way of the pointer as well: it is drawn after the
                 play button and in the same place, so left hit-testable it
                 would catch every click meant for play while being invisible
                 about it. Disabling the button is not enough — a disabled
                 control still takes the hit and simply does nothing with it,
                 which stops it reaching what is underneath. -->
            <Grid x:Name="BackSlot"
                  HorizontalAlignment="Center"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Button x:Name="Back"
                        Style="{StaticResource PlayButton}"
                        Click="Back_Click"
                        ToolTip="Back">
                    <Path Data="{StaticResource Cross}"
                          Stretch="Uniform"
                          Width="17" Height="17"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Ample, and the same measure twice: the buttons sit 22 in from the
             top and 22 in from the right. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,22,22,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <!-- The window, not the buttons. Revealing them only
                             when the pointer is on one of them would mean
                             finding them blind first.

                             Still quicker in than out, but not by as much as
                             it was: arriving too fast reads as a flicker
                             rather than a fade, and the thing you notice is
                             that something appeared rather than that it
                             arrived. They
                             stay clickable while invisible, which costs
                             nothing — the pointer has to be in the window to
                             click at all, and that is what brings them back. -->
                        <DataTrigger Value="True"
                                     Binding="{Binding IsMouseOver,
                                               RelativeSource={RelativeSource AncestorType=Window}}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.30">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>


            <Button Style="{StaticResource ChromeButton}"
                    Click="Minimise_Click"
                    ToolTip="Minimise">
                <Path Data="M 0,0 H 13"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      SnapsToDevicePixels="True"/>
            </Button>

            <Button x:Name="CloseButton"
                    Style="{StaticResource ChromeButton}"
                    Click="Close_Click"
                    Margin="4,0,0,0"
                    ToolTip="Close">
                <Path Data="M 0,0 L 12,12 M 12,0 L 0,12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      SnapsToDevicePixels="True"/>
            </Button>

        </StackPanel>

    </Grid>
    </Border>
</Window>
