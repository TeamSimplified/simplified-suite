<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simplified Launcher. Picks mods, installs them, and starts the game.
       Generation two: what ships today is a Python and WebView2 app at v3.2,
       kept at F:\Claude Code\Simplified Launcher, and this replaces it.

       In the suite, deliberately not of it. What it takes from the repository:
       the build settings in Directory.Build.props, and Shared/GameDirDetector,
       because finding the game install is the same problem here as it is in
       every editor and there is no second way worth having. What it does not
       take: SimplifiedUi, the shared chrome, the palette, the rest of Shared/,
       and a Core project. Every colour and every control it draws is in its own
       XAML, which is the point — it is a launcher rather than another editor,
       and the one app here that is meant to look like itself. Anyone tidying it
       toward the house style should read that sentence twice.

       What a suite app normally carries and this does not: app.manifest, an
       ApplicationIcon, x64 only, the _IsPublishing single-file block, and a
       line in tools/release.ps1's Ships list. Nothing packages it yet, so none
       of them have come up.

       Portable, like the rest: when it starts keeping settings they go in a
       config.json beside the exe, and it writes nothing outside its own
       folder. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Simplified Launcher</AssemblyName>
    <RootNamespace>SimplifiedLauncher</RootNamespace>

    <!-- The same icon Simplified ERP wears, and five other apps with it. A copy
         in this app's own folder rather than a path into ERP's, because that is
         how every app here holds its icon and an app reaching into another one
         for its identity is a dependency nobody expects.

         There is no window icon to go with it: this window has no title bar to
         put one in. What this sets is the exe's, which is what the taskbar and
         Alt-Tab read. -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>

    <!-- Per-monitor DPI, which a window drawing its own corners wants. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off, as everywhere else: embedding the natives makes the host unpack
         them to the user's temp folder at startup, outside the app folder and
         never cleaned up. The app is portable and that would be the one thing
         it wrote somewhere else. MoveNativesIntoRuntimeFolder tidies them
         instead, and NativeLibraryFolder teaches the app to look there. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
  </Target>

  <!-- The game install search every app here uses: Steam's libraries from the
       registry and libraryfolders.vdf, then the usual EA and Origin roots, and
       only ever F1 25 back. Linked rather than copied, so the launcher looks in
       exactly the places the editors look and there is one file to fix when the
       next game moves the goalposts. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
  </ItemGroup>

  <!-- The minimise animation, which every window here needs for the same reason
       and gets from the same file. The suite's apps reach it through
       SimplifiedUi; this one has no SimplifiedUi, so it links it directly. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\MinimiseAnimation.cs" Link="MinimiseAnimation.cs" />
  </ItemGroup>

  <!-- Outfit, embedded rather than installed. The app is portable and goes out
       as a folder someone unzips, so a font it only borrowed from the machine
       is a font it does not have: every heading would quietly fall back to
       whatever Windows picked.

       The variable font, not the static weights. WPF turns out to read its
       named instances, so one file carries all nine — measured against the five
       statics it replaces, and "Simplified" at 32px comes out 137.823, 139.293,
       140.797, 144.353 and 147.750 wide at Light, Normal, Medium, SemiBold and
       Bold either way. Identical metrics, 108 KB instead of 275 KB, and Thin,
       ExtraLight, ExtraBold and Black available for nothing.

       Worth knowing if this is ever swapped back: in the old naming only
       Regular and Bold call themselves "Outfit", and Light, Medium and SemiBold
       are their own families, grouping under Outfit only through the
       typographic name. Fonts.GetFontFamilies is how to check what actually
       arrives as one family.

       OFL.txt travels with it. The licence asks for it, and a font shipped
       inside an exe is still a font being distributed. -->
  <ItemGroup>
    <Resource Include="..\..\..\Shared\Fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <Content Include="..\..\..\Shared\Fonts\OFL.txt" Link="Fonts\OFL.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reads a dropped mod archive whatever shape it is in: zip, 7z, rar, tar and
       the older ones. Managed, so there is no 7za.exe or UnRAR.exe to ship, no
       process to spawn and no console window to hide. The version is pinned in
       Directory.Packages.props, where the reason for the floor is written down. -->
  <ItemGroup>
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

</Project>
