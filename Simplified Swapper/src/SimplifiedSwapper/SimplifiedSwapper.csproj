<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedSwapper</RootNamespace>
    <AssemblyName>Simplified Swapper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off, as everywhere else: embedding the natives makes the host unpack
         them to the user's temp folder at startup, outside the app folder and
         never cleaned up. MoveNativesIntoRuntimeFolder tidies them instead. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- The two engines, each still in its own project, plus the suite's look.
       Nothing about either swap is reimplemented here. -->
  <ItemGroup>
    <ProjectReference Include="..\SimplifiedSwapper.Core\SimplifiedSwapper.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified Chassis Swapper\src\SimplifiedChassisSwapper.Core\SimplifiedChassisSwapper.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified Driverwear Swapper\src\SimplifiedDriverwearSwapper.Core\SimplifiedDriverwearSwapper.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
  </Target>

  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
  </ItemGroup>

</Project>
