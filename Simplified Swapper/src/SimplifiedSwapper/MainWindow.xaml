<Window x:Class="SimplifiedSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SimplifiedSwapper"
        Title="Simplified Swapper"
        Width="920" Height="760" MinWidth="760" MinHeight="620"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Closing="OnWindowClosing" Closed="OnWindowClosed"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the name and the caption buttons, nothing else. What the
             app does lives on the bar below. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Simplified Swapper"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandInk}"/>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- Which template is open, the way Studio names the open
                     project up here. Only one of the two is ever showing. -->
                <TextBlock Name="TemplateNameLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
                <TextBlock Name="NoTemplateLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextDisabled}"
                           Text="No template open"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>

            </DockPanel>
        </Border>

        <!-- Action bar, laid out the way Studio's project bar is: settings and
             the file operations on the left, what the app does on the right, on
             the row under the title bar rather than in it.

             All of it belongs to the window rather than a tab. The template
             because both swaps go into the same one, settings because both read
             the same game folder, and Swap because there is one of it: it runs
             whichever tab is in front. -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1" Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconOpen}" Click="OpenTemplate_Click"
                        ToolTip="Open template    (Ctrl+O)"/>

                <!-- Save, not Save as: a template is opened, swapped into and
                     saved back. SaveTemplateAsButton stays, hidden, because
                     Ctrl+Shift+S reaches it and OnTemplateStateChanged drives
                     its IsEnabled with the rest. -->
                <Button DockPanel.Dock="Left" Name="SaveTemplateButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSave}" Margin="6,0,0,0"
                        Click="SaveTemplate_Click" IsEnabled="False"
                        ToolTip="Save template    (Ctrl+S — Ctrl+Shift+S saves as)"/>
                <Button DockPanel.Dock="Left" Name="SaveTemplateAsButton" Visibility="Collapsed"
                        Click="SaveTemplateAs_Click" IsEnabled="False"/>

                <!-- Reverse visual order again: Close sits outermost. -->
                <Button DockPanel.Dock="Right" Name="CloseTemplateButton" Content="Close"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False"
                        Click="CloseTemplate_Click"/>
                <Button DockPanel.Dock="Right" Name="SwapButton" Content="Swap"
                        Padding="16,7" FontWeight="SemiBold" IsEnabled="False"
                        Click="Swap_Click"/>
            </DockPanel>
        </Border>

        <!-- One window, both swaps. The panels are the two apps' own windows,
             so what each tab does is what that app does. -->
        <TabControl Grid.Row="2" Name="Tabs" Padding="0" BorderThickness="0"
                    Background="{DynamicResource Surface}">
            <TabItem Header="Chassis">
                <local:ChassisPanel x:Name="Chassis"/>
            </TabItem>
            <TabItem Header="Driverwear">
                <local:DriverwearPanel x:Name="Driverwear"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
