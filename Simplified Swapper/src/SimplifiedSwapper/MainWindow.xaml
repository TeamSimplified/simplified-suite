<Window x:Class="SimplifiedSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SimplifiedSwapper"
        Title="Simplified Swapper"
        Width="920" Height="500" MinWidth="760" MinHeight="470"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Closing="OnWindowClosing" Closed="OnWindowClosed"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the name and the caption buttons, nothing else. What the
             app does lives on the bar below. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The caption buttons are declared first, before anything on
                     the left, because a DockPanel hands out space in declaration
                     order and not by side. Declared last they were the first
                     thing to lose it: narrowing the window used to take the
                     close button away rather than squeeze the title. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Simplified Swapper"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandInk}"/>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- A rule between the mark and the document, as Studio has.
                     Without it the version pill and the template name read as
                     one run of text. -->
                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <!-- Which template is open, the way Studio names the open
                     project up here. Only one of the two is ever showing. -->
                <TextBlock Name="TemplateNameLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,10,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           MinWidth="0" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
                <TextBlock Name="NoTemplateLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextDisabled}"
                           Text="No template open"/>

            </DockPanel>
        </Border>

        <!-- Action bar, laid out the way Studio's project bar is: settings and
             the file operations on the left, what the app does on the right, on
             the row under the title bar rather than in it.

             All of it belongs to the window rather than to either swap. The
             template because both go into the same one, settings because both
             read the same game folder, and Swap because there is one of it: it
             runs whichever of the two has been asked for. -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <!-- Same as the title bar: declared first so they keep their
                     space when the window narrows. Reverse visual order, since
                     a DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="CloseTemplateButton" Content="Close"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False"
                        Click="CloseTemplate_Click"/>
                <Button DockPanel.Dock="Right" Name="SwapButton" Content="Swap"
                        Padding="16,7" FontWeight="SemiBold" IsEnabled="False"
                        Click="Swap_Click"/>

                <!-- Left of Swap, and nothing to do with it: this reads the
                     driverwear that is selected and writes its UV layouts out.
                     It needs no template, no swap and no save. -->
                <Button DockPanel.Dock="Right" Name="ExtractUvButton" Content="Extract UVs"
                        Padding="14,7" Margin="0,0,8,0" IsEnabled="False"
                        Click="ExtractUv_Click"
                        ToolTip="Save every UV layout in the selected driverwear ERP as a transparent PNG, drawn at each texture's own size"/>

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1" Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconOpen}" Click="OpenTemplate_Click"
                        ToolTip="Open template    (Ctrl+O)"/>

                <!-- Save as, not Save: a save icon asks where, in every app in
                     the suite. It matters most here, because what gets opened is
                     usually a template straight out of the pack — one click on a
                     Save icon would overwrite the master copy with a swap.

                     SaveTemplateButton stays, hidden, because Ctrl+S reaches it
                     and OnTemplateStateChanged drives its IsEnabled. -->
                <Button DockPanel.Dock="Left" Name="SaveTemplateAsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSave}" Margin="6,0,0,0"
                        Click="SaveTemplateAs_Click" IsEnabled="False"
                        ToolTip="Save template as…    (Ctrl+S saves in place)"/>
                <Button DockPanel.Dock="Left" Name="SaveTemplateButton" Visibility="Collapsed"
                        Click="SaveTemplate_Click" IsEnabled="False"/>
            </DockPanel>
        </Border>

        <!-- One page, both swaps. They were tabs, which made them read as two
             jobs; they are two halves of one — a car and what its drivers wear
             — going into the same template, and each is now three lines. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource Surface}">
            <StackPanel Margin="0,4,0,12">
                <local:ChassisPanel x:Name="Chassis"/>
                <local:DriverwearPanel x:Name="Driverwear"/>
            </StackPanel>
        </ScrollViewer>

        <!-- One status line for the window. The panels report through the host
             rather than each carrying their own, since only one thing happens
             at a time and two of these would only ever disagree. -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Name="ProgressLabel" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11.5"/>
                    <ProgressBar Name="SwapProgress" Height="4" Minimum="0" Maximum="1"
                                 Background="{DynamicResource SurfaceSunken}"
                                 Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                </DockPanel>
                <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
