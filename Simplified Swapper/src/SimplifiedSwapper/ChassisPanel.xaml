<UserControl x:Class="SimplifiedSwapper.ChassisPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- Keyed styles inherit nothing unless they say BasedOn, so a keyed
             Button style without one would replace the themed template outright
             and land this window back on the stock look. The TextBlock ones
             carry their own Foreground for the same reason. -->
        <!-- Top, not centre. A row is a control with a line or two of hint
             under it, and a centred label drifts down past the thing it names —
             on the tallest row it ends up level with the hint instead. The top
             margin is what puts it on the control's own text. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,7,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The swap button the toolbar used to hold. It is collapsed rather
             than gone because every validation path in this panel sets its
             state, and the window's real Swap button reads that state back. -->
        <Button Name="SwapButton" Content="Swap" IsEnabled="False" Visibility="Collapsed"/>

        <!-- Form -->
        <Border Grid.Row="2" Padding="20,16,20,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 the car, and the slot it takes -->
                    <RowDefinition Height="Auto"/>  <!-- 1 what it is called there -->
                    <RowDefinition Height="Auto"/>  <!-- 2 engine audio, hidden -->
                </Grid.RowDefinitions>

                <!-- ── The car ───────────────────────────────────────────── -->
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Car chassis:"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                    <ComboBox Name="ChassisCarBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                              DisplayMemberPath="Label" MaxDropDownHeight="420"
                              IsEnabled="False" SelectionChanged="ChassisCar_Changed"/>

                    <!-- Collapsed, not removed: still the path the swap reads,
                         and still what every validation path here looks at. -->
                    <TextBox Name="ChassisBox" TextChanged="Inputs_Changed" Visibility="Collapsed"/>

                    <!-- The slot it takes over. Was a dropdown of one, which
                         invited a choice that isn't there — the template names
                         the team. It stays a dropdown only for My Team, whose
                         six engine slots are a real choice. -->
                    <ComboBox Name="TeamErpBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                              DisplayMemberPath="Label" MaxDropDownHeight="420" Margin="0,6,0,0"
                              Visibility="Collapsed" SelectionChanged="TeamErp_Changed"/>
                    <TextBox Name="TeamBox" TextChanged="Inputs_Changed" Visibility="Collapsed"/>

                    <TextBlock Name="TeamErpHint" Style="{StaticResource Hint}"/>
                    <TextBlock Name="ChassisHint" Style="{StaticResource Hint}"
                               Text="The car you want to drive — its model, textures and cameras are kept."/>
                </StackPanel>

                <!-- ── What it is called in the slot ─────────────────────── -->
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Resource string:"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                    <TextBox Name="NewNameBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                             TextChanged="Inputs_Changed"/>

                    <!-- The name being replaced is the car's own and nobody
                         chooses it, so it reads rather than edits. Still a box
                         underneath, because the swap and the validation both
                         take it from there. -->
                    <TextBox Name="OldNameBox" TextChanged="Inputs_Changed" Visibility="Collapsed"/>
                    <TextBlock Name="OldNameLabel" Style="{StaticResource Hint}"/>
                    <TextBlock Name="LengthHint" Style="{StaticResource Hint}"/>
                </StackPanel>

                <!-- Driver animations used to be three rows here: which season's
                     animations, which set to take, and what to publish it as.
                     The swap works all three out on its own — the season from
                     the chassis's year, both sets by matching their names — so
                     there was nothing here to decide, only somewhere to get it
                     wrong. Rows 5-8 are left empty rather than renumbered. -->

                <!-- ── Engine audio ──────────────────────────────────────── -->
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Engine audio" Visibility="Collapsed"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,18" Visibility="Collapsed">
                    <ComboBox Name="EngineAudioBox" HorizontalAlignment="Left" MinWidth="240" MaxWidth="420"
                              DisplayMemberPath="Label" MaxDropDownHeight="420"
                              SelectionChanged="EngineAudio_Changed"/>
                    <TextBlock Name="EngineAudioHint" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The log the window's status line replaced. Kept, hidden, because
             every step still writes to it and a swap's detail has to land
             somewhere. -->
        <TextBox Name="LogBox" Visibility="Collapsed" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"/>

    </Grid>
</UserControl>
