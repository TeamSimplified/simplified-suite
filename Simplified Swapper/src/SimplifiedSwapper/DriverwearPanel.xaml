<UserControl x:Class="SimplifiedSwapper.DriverwearPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- Keyed styles inherit nothing unless they say BasedOn, so a keyed
             Button style without one would replace the themed template outright
             and land this window back on the stock look. The TextBlock ones
             carry their own Foreground for the same reason. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The swap button the toolbar used to hold. It is collapsed rather
             than gone because every validation path in this panel sets its
             state, and the window's real Swap button reads that state back. -->
        <Button Name="SwapButton" Content="Swap" IsEnabled="False" Visibility="Collapsed"/>

        <!-- Body -->
        <Border Grid.Row="2" Padding="20,4,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 the wear, and who wears it -->
                    <RowDefinition Height="Auto"/>  <!-- 1 the file list, hidden -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                           Text="Team's driverwear:"/>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <ComboBox Name="DriverwearBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                              DisplayMemberPath="Label" MaxDropDownHeight="420"
                              IsEnabled="False" SelectionChanged="Selection_Changed"/>

                    <!-- Who wears it. A dropdown only for My Team, whose suits
                         are the player's own and a real choice; for everyone
                         else the template names the team, so it reads as text. -->
                    <ComboBox Name="TeamBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                              DisplayMemberPath="Label" MaxDropDownHeight="420" Margin="0,6,0,0"
                              Visibility="Collapsed" SelectionChanged="Selection_Changed"/>

                    <TextBlock Name="TeamHint" Style="{StaticResource Hint}"/>
                    <TextBlock Name="DriverwearHint" Style="{StaticResource Hint}"
                               Text="The suit, gloves and boots the team will race in."/>
                </StackPanel>

                <DockPanel Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Name="DriversHint" Style="{StaticResource Hint}"/>
                    <ListBox Name="DriverList" Background="{DynamicResource SurfaceSunken}"
                             FontFamily="Consolas" FontSize="11.5"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
