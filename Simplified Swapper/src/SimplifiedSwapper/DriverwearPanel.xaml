<UserControl x:Class="SimplifiedSwapper.DriverwearPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- Keyed styles inherit nothing unless they say BasedOn, so a keyed
             Button style without one would replace the themed template outright
             and land this window back on the stock look. The TextBlock ones
             carry their own Foreground for the same reason. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The swap button the toolbar used to hold. It is collapsed rather
             than gone because every validation path in this panel sets its
             state, and the window's real Swap button reads that state back. -->
        <Button Name="SwapButton" Content="Swap" IsEnabled="False" Visibility="Collapsed"/>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 driverwear -->
                <RowDefinition Height="Auto"/>  <!-- 1 team -->
                <RowDefinition Height="Auto"/>  <!-- 2 output -->
                <RowDefinition Height="*"/>     <!-- 3 files found -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Driverwear"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="DriverwearBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="DriverwearHint" Style="{StaticResource Hint}"
                           Text="The suit, gloves and boots you want to use."/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Team"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="TeamBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="TeamHint" Style="{StaticResource Hint}"
                           Text="The team that will wear it."/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Top" Margin="0,2,10,0" Text="Files" Visibility="Collapsed"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Name="DriversHint" Style="{StaticResource Hint}"
                           Margin="0,0,0,4"
                           Text="Press Swap to gather the files each side contributes."/>
                <ListBox Name="DriverList" Background="{DynamicResource SurfaceSunken}"
                         FontFamily="Consolas" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
