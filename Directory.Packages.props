<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The versions every app already pinned, unchanged. -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.6" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <PackageVersion Include="System.IO.Packaging" Version="9.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- The launcher's, for reading a mod archive of any shape. 0.48.0 is a
         floor rather than a preference: every version before it carries
         CVE-2026-44788, a path traversal in WriteToDirectory, and this reads
         archives people downloaded from the internet. The launcher writes its
         own entries rather than calling that method, so the two together are
         belt and braces. -->
    <PackageVersion Include="SharpCompress" Version="0.48.0" />

    <!-- Reading an SVG, for the Sponsor Editor's artwork import. Managed only,
         and WPF's own drawing model rather than a native rasteriser, which is
         what lets it go inside a single-file self-contained build with nothing
         beside the exe. Linked in by the one app that wants it, through
         Shared\SvgPicture.cs, so the rest of the suite does not carry it. -->
    <PackageVersion Include="SharpVectors.Reloaded" Version="1.8.6" />

    <!-- The Universal Exporter's, at the versions it shipped with on its own:
         Helix's WPF and DirectX viewports, and Assimp for writing FBX.
         HelixToolkit.Wpf only ships .NET Framework builds and restores with
         NU1701; it has run that way in the exporter since 1.0. -->
    <PackageVersion Include="HelixToolkit.Wpf" Version="2.25.0" />
    <PackageVersion Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageVersion Include="AssimpNet" Version="5.0.0-beta1" />

    <!-- NefsLib's own, at the versions it pins. It reads the NeFS archive
         inside the game exe, which is where the language files live. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.0.14" />
  </ItemGroup>
</Project>
