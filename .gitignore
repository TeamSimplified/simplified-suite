# Build output.
[Bb]in/
[Oo]bj/

# Packaged builds, all under one folder. Each app's release step rebuilds
# them, and they are the exe and zip themselves - several hundred megabytes
# that would otherwise sit in every clone.
/Release/

# What the apps write next to themselves at runtime.
config.json

# Scratch left by the dev harnesses under tools/.
*.user

# Files from the game. They are never committed: each developer takes them
# from their own install (see README.md, "Game files are not included").
/Simplified Sponsor Editor/original/*.erp
/Simplified Team Editor/original/*.bin
/Simplified Team Editor/original/*.lng
!/Simplified Team Editor/original/2026_team_keys.lng
/Simplified Team Editor/original/ui/
/Simplified Team Editor/original/localisation/
