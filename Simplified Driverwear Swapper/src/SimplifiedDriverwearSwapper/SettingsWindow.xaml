<Window x:Class="SimplifiedDriverwearSwapper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="620" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <StackPanel Margin="20,18,20,10">
            <TextBlock Text="Game folder" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Browse" Padding="14,6" Margin="8,0,0,0"
                        Click="Browse_Click"/>
                <TextBox Name="GameDirBox" Padding="4,4" VerticalContentAlignment="Center"
                         TextChanged="GameDir_Changed"/>
            </DockPanel>
            <TextBlock Name="GameDirStatus" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="Your F1 25 install — where the game's own files are read from."/>
        </StackPanel>

        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel>
                <TextBlock Text="Credits" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="19">
                    Petar Tasev — Underlying ERP structure and format code<LineBreak/>
                    BIKER7202 — For discovering the method to swap driverwear<LineBreak/>
                    Team Simplified — App functionality and Design<LineBreak/>
                    Claude Code — Coding
                </TextBlock>
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="18,6" IsCancel="True"/>
                <Button Content="Save" Padding="22,6" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
