<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimplifiedDriverwearSwapper.Core</RootNamespace>
    <AssemblyName>SimplifiedDriverwearSwapper.Core</AssemblyName>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- No ERP code of its own: every game file is read and written by the
       Toolkit, which is linked in rather than launched. That keeps the format in
       one place across the suite — anything missing gets added to the Toolkit
       rather than reimplemented here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Simplified Toolkit\src\SimplifiedToolkit.Core\SimplifiedToolkit.Core.csproj" />
  </ItemGroup>

</Project>
