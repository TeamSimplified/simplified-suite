<Window x:Class="SimplifiedDriverwearSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simplified Driverwear Swapper"
        Width="900" Height="620" MinWidth="700" MinHeight="480"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Field label: right-aligned into the gutter so inputs line up. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A929C"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#EEF1F5" BorderBrush="#CCD3DC" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Settings" Padding="14,4" Click="Settings_Click"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1" Background="#CCD3DC"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#333"
                           FontWeight="SemiBold" Text="Driverwear swap"/>

                <Button DockPanel.Dock="Right" Name="SwapButton" Content="Swap" Padding="22,4"
                        FontWeight="SemiBold" IsEnabled="False" Click="Swap_Click"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 driverwear -->
                <RowDefinition Height="Auto"/>  <!-- 1 team -->
                <RowDefinition Height="Auto"/>  <!-- 2 output -->
                <RowDefinition Height="*"/>     <!-- 3 files found -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Driverwear"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="DriverwearBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="DriverwearHint" Style="{StaticResource Hint}"
                           Text="The suit, gloves and boots you want to use."/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Team"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                <ComboBox Name="TeamBox" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420"
                          DisplayMemberPath="Label" MaxDropDownHeight="420"
                          IsEnabled="False" SelectionChanged="Selection_Changed"/>
                <TextBlock Name="TeamHint" Style="{StaticResource Hint}"
                           Text="The team that will wear it."/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Save to"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource BrowseButton}"
                            Click="BrowseOutput_Click"/>
                    <TextBox Name="OutputBox" TextChanged="Output_Changed"/>
                </DockPanel>
                <TextBlock Name="OutputHint" Style="{StaticResource Hint}"
                           Text="The swapped ERP the app will write."/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Top" Margin="0,2,10,0" Text="Files"/>
            <DockPanel Grid.Row="3" Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Name="DriversHint" Style="{StaticResource Hint}"
                           Margin="0,0,0,4"
                           Text="Press Swap to gather the files each side contributes."/>
                <ListBox Name="DriverList" BorderBrush="#DDE1E6" Background="#FFF"
                         FontFamily="Consolas" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#CCD3DC" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Name="StatusLabel" Foreground="#666" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
