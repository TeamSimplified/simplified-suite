<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedDriverwearSwapper</RootNamespace>
    <AssemblyName>Simplified Driverwear Swapper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded rather than shipped loose (the Studio ships a copy because it
         loads the file at runtime). Embedding gives the exe its icon and WPF
         picks it up for the window too, so the release stays a single file. -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedDriverwearSwapper.Core\SimplifiedDriverwearSwapper.Core.csproj" />
  </ItemGroup>

  <!-- Ship the Simplified Toolkit CLI loose next to the exe. It does all the ERP
       work for this app, so it isn't optional.

       Content, not None: PublishSingleFile strips None items. ExcludeFromSingleFile
       keeps it a real file on disk, which it has to be — a single-file bundle can't
       execute an exe it hasn't extracted.

       Named explicitly rather than globbing tools/**, which would also sweep in dev
       harnesses and their bin/obj. -->
  <ItemGroup>
    <Content Include="..\..\tools\stk.exe"
             Link="tools\stk.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

</Project>
