<Window x:Class="SimplifiedDriverSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SimplifiedUi;assembly=SimplifiedUi"
        Title="Simplified Driver Swapper"
        Width="1240" Height="860" MinWidth="1000" MinHeight="700"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Every keyed style says BasedOn. Without it the keyed style replaces
             the themed template outright and drops that control back to the
             stock Windows look, which stays light whatever the palette says. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Rows the save will touch, so a glance at the table shows the work.
             Hover and selection are template triggers and still win over this,
             which is right: the row under the pointer should answer the pointer. -->
        <Style x:Key="GridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The rest of the table's look comes from the shared theme; these are
             the behaviour settings that differ per grid. -->
        <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
        </Style>

        <!-- The panel under each table, holding the editor for whatever is
             selected. Sunken rather than outlined, so the table stays the thing
             being looked at. -->
        <Style x:Key="EditorPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- A rule between the mark and the document. Without it the
                     version pill and the file name read as one run of text. -->
                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" Name="FileNameLabel" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="No database open"/>
                <TextBlock DockPanel.Dock="Left" Name="PendingLabel" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                           Visibility="Collapsed" Text="unsaved changes"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="12,0,12,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Name="NewButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconNew}" Click="New_Click"
                        ToolTip="Start from the game's database — restoring the backup first if there is one"/>
                <Button DockPanel.Dock="Left" Name="OpenButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconOpen}" Click="Open_Click" Margin="4,0,0,0"
                        ToolTip="Open a gamedatabases.bin"/>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="12,0,12,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <!-- Which grid is being edited. Chips rather than a dropdown, as
                     the Team Editor has it: two choices, both worth seeing. -->
                <RadioButton DockPanel.Dock="Left" Name="Season2026Chip" Content="2026"
                             Style="{StaticResource ChannelChip}" Checked="Season_Checked"
                             IsChecked="True" ToolTip="The 2026 grid"/>
                <RadioButton DockPanel.Dock="Left" Name="Season2025Chip" Content="2025"
                             Style="{StaticResource ChannelChip}" Checked="Season_Checked"
                             ToolTip="The grid the game ships with"/>

                <Button DockPanel.Dock="Right" Name="PackageButton" Content="Package"
                        Margin="12,0,0,0" IsEnabled="False" Click="Package_Click"
                        ToolTip="Write a zip holding the edited database at its in-game path, leaving your game files alone"/>
                <Button DockPanel.Dock="Right" Name="SaveButton" Content="Save"
                        FontWeight="SemiBold" IsEnabled="False" Click="Save_Click"
                        Margin="12,0,0,0" ToolTip="Write the changes into the database that is open"/>
                <Button DockPanel.Dock="Right" Name="ExportButton" Content="Export changes"
                        IsEnabled="False" Click="Export_Click" Margin="8,0,0,0"
                        ToolTip="Save the pending changes to a file someone else can import"/>
                <Button DockPanel.Dock="Right" Name="ImportButton" Content="Import changes"
                        IsEnabled="False" Click="Import_Click"
                        ToolTip="Apply changes exported from another copy of this app"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <!-- ══════════════ Grid ══════════════ -->
            <TabItem Header="Grid">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="2,0,2,8"
                               Text="Pick a seat, then choose who sits in it. Seats you don't touch are left empty, which is how the game finds its own default lineup. The helmet follows the driver; suit and gloves become the plain team kit unless you override them."/>

                    <DataGrid Grid.Row="1" Name="SeatGrid" Style="{StaticResource ReadOnlyGrid}"
                              RowStyle="{StaticResource GridRow}"
                              SelectionChanged="SeatGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seat"   Binding="{Binding Slot}"    Width="52"/>
                            <DataGridTextColumn Header="Team"   Binding="{Binding Team}"    Width="130"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding Driver}"  Width="*" MinWidth="170"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}"  Width="80"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding Number}"  Width="76"/>
                            <DataGridTextColumn Header="Helmet" Binding="{Binding Helmet}"  Width="90"/>
                            <DataGridTextColumn Header="Suit"   Binding="{Binding Suit}"    Width="80"/>
                            <DataGridTextColumn Header="Gloves" Binding="{Binding Gloves}"  Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource EditorPanel}">
                        <StackPanel>
                            <TextBlock Name="SeatSelectionLabel" FontWeight="SemiBold"
                                       Text="No seat selected" Margin="0,0,0,2"/>
                            <TextBlock Name="SeatDetailLabel" Style="{StaticResource Hint}" Margin="0,0,0,8"/>

                            <!-- Always available: who sits here, and under what number. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Driver"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Name="DriverBox" Margin="0,0,0,4"
                                          IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Display"/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Name="AssignButton" Content="Assign" Style="{StaticResource RowButton}"
                                            IsEnabled="False" Click="Assign_Click"/>
                                    <Button Name="ResetSeatButton" Content="Reset seat" Style="{StaticResource RowButton}"
                                            IsEnabled="False" Click="ResetSeat_Click"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Number"/>
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="0–99, or 255 for the driver's own"/>
                                    <TextBox Name="NumberBox" Width="70" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Name="NumberSetButton" Content="Override" Style="{StaticResource RowButton}"
                                            IsEnabled="False" Click="NumberOverride_Click"/>
                                    <Button Name="NumberClearButton" Content="Clear" Style="{StaticResource RowButton}"
                                            IsEnabled="False" Click="NumberClear_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Kit. Hidden unless advanced swapping is on: the rules below
                                 handle it on their own, so this is only for the exceptions. -->
                            <StackPanel Name="AdvancedKitPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Helmet"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Name="HelmetBox" Margin="0,0,0,4"
                                              IsEditable="True" IsTextSearchEnabled="True"/>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Name="HelmetSetButton" Content="Override" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="HelmetOverride_Click"/>
                                        <Button Name="HelmetClearButton" Content="Clear" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="HelmetClear_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Suit"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Name="SuitBox" Margin="0,0,0,4"
                                              IsEditable="True" IsTextSearchEnabled="True"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Name="SuitSetButton" Content="Override" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="SuitOverride_Click"/>
                                        <Button Name="SuitClearButton" Content="Clear" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="SuitClear_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Gloves"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Name="GloveBox"
                                              IsEditable="True" IsTextSearchEnabled="True"/>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                        <Button Name="GloveSetButton" Content="Override" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="GloveOverride_Click"/>
                                        <Button Name="GloveClearButton" Content="Clear" Style="{StaticResource RowButton}"
                                                IsEnabled="False" Click="GloveClear_Click"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Name="HelmetFollowsBox" Content="Helmet follows the driver" IsChecked="True"
                                              Click="KitOption_Changed"/>
                                    <CheckBox Name="SuitTeamBox" Content="Suit becomes team kit" IsChecked="True"
                                              Margin="16,0,0,0" Click="KitOption_Changed"/>
                                    <CheckBox Name="GloveTeamBox" Content="Gloves become team kit" IsChecked="True"
                                              Margin="16,0,0,0" Click="KitOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════ Drivers ══════════════ -->
            <TabItem Header="Drivers">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="Name fields hold language keys, not names — pick an existing key or type your own."/>
                        <TextBox Name="AttributeSearchBox" Width="240" HorizontalAlignment="Left"
                                 TextChanged="AttributeSearch_Changed"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" Name="DriverGrid" Style="{StaticResource ReadOnlyGrid}"
                              RowStyle="{StaticResource GridRow}"
                              SelectionChanged="DriverGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"           Binding="{Binding Index}"       Width="50"/>
                            <DataGridTextColumn Header="Driver id"   Binding="{Binding DriverId}"    Width="180"/>
                            <DataGridTextColumn Header="Initials"    Binding="{Binding Initials}"    Width="70"/>
                            <DataGridTextColumn Header="Nationality" Binding="{Binding Nationality}" Width="110"/>
                            <DataGridTextColumn Header="First name"  Binding="{Binding FirstName}"   Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Last name"   Binding="{Binding LastName}"    Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Full name"   Binding="{Binding FullName}"    Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Head"        Binding="{Binding Head}"        Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Audio"       Binding="{Binding AudioName}"   Width="*" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource EditorPanel}">
                        <StackPanel>
                            <TextBlock Name="DriverSelectionLabel" FontWeight="SemiBold"
                                       Text="No driver selected" Margin="0,0,0,8"/>
                            <Grid Name="AttributeFieldGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Name="AttributeApplyButton" Content="Apply to driver"
                                        IsEnabled="False" Click="AttributeApply_Click"/>
                                <Button Name="AttributeRevertButton" Content="Discard changes"
                                        Margin="8,0,0,0" IsEnabled="False" Click="AttributeRevert_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <!-- The ring turns while the app is working, and everything
                     above this row is switched off for as long as it does —
                     see SimplifiedUi.Busy. -->
                <DockPanel>
                    <ui:Spinner x:Name="StatusSpinner" DockPanel.Dock="Left"
                                VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="Open a gamedatabases.bin to begin."/>
                </DockPanel>
                <!-- Collapsed unless a team build turns it on from Ctrl+T. -->
                <TextBox Name="LogBox" Height="72" Margin="0,8,0,0" IsReadOnly="True"
                         Visibility="Collapsed"
                         FontFamily="Consolas" FontSize="11.5"
                         Background="{DynamicResource SurfaceSunken}"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
