<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedTeamEditor</RootNamespace>
    <AssemblyName>Simplified Team Editor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off deliberately. Turning it on embeds the native libraries in the
         single file, and the host then extracts them to %TEMP%\.net at startup:
         once per build, never cleaned up, and outside the app folder - which
         this app does not do. They publish as files instead, and
         MoveNativesIntoRuntimeFolder below tidies them away. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedTeamEditor.Core\SimplifiedTeamEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <!-- The other half of MoveNativesIntoRuntimeFolder below: nothing looks in a
       subfolder by default, so the app has to say where they went. Linked from
       Shared rather than copied, so every app resolves them the same way. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
    <Compile Include="..\..\..\Shared\ColourDialog.cs" Link="ColourDialog.cs" />
    <Compile Include="..\..\..\Shared\ScreenColourPicker.cs" Link="ScreenColourPicker.cs" />
    <Compile Include="..\..\..\Shared\FlatButton.cs" Link="FlatButton.cs" />
  </ItemGroup>

  <!-- Ship icon.ico loose next to the published EXE. Content items survive
       PublishSingleFile (None items get stripped); ExcludeFromSingleFile keeps
       them as separate files instead of embedded. -->
  <ItemGroup>
    <Content Include="..\..\icon.ico" Link="icon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- texconv, which converts between PNG and the compressed forms a texture
       array holds. It goes in runtime\ beside the native libraries, which is
       where TexconvRunner looks for it. -->
  <ItemGroup>
    <Content Include="../../tools/texconv.exe"
             Link="runtime/texconv.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- The app's own files beside the originals: the 2026 team-name keys and
       their list. The game's files a package is built from - the team database,
       the eleven language files and the team-branding texarrays - are not
       shipped: the app takes them out of the installed game into
       runtime\original on first run and after each patch (GameOriginals,
       LanguageFiles), and writes originals.json saying which build. A copy kept
       locally in original\ for development is left out of the build. -->
  <ItemGroup>
    <Content Include="..\..\original\**\*"
             Exclude="..\..\original\gamedatabases.2025.bin;..\..\original\ui\**;..\..\original\localisation\**;..\..\original\originals.json;..\..\original\.incoming\**"
             Link="runtime\original\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- SHA-256 of the game files packaging reads out of the install, so a mod
       already sitting in one can be noticed before it goes out inside somebody's
       package. Written by tools/game-hashes.ps1; read by GameFileGuard, which
       looks for it here. -->
  <ItemGroup>
    <Content Include="..\..\..\Shared\game-files.json" Link="runtime\game-files.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
      <PublishedNativeLibrary Include="$(PublishDir)x64\*.dll"/>
      <UnusedArchitectureNative Include="$(PublishDir)x86\**\*"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
    <Delete Files="@(UnusedArchitectureNative)"/>
    <RemoveDir Directories="$(PublishDir)x64;$(PublishDir)x86"/>
  </Target>

</Project>
