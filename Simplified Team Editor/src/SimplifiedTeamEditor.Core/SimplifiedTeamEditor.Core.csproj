<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimplifiedTeamEditor.Core</RootNamespace>
    <AssemblyName>SimplifiedTeamEditor.Core</AssemblyName>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- No format code of its own: ERP archives, DDS, texconv and the endian
       plumbing under them are the shared library's, and this app calls it with
       paths. That keeps the format in one place across the suite - anything
       missing gets added there rather than reimplemented here. The packages
       those need arrive with it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Language Library\SimplifiedLanguage.csproj" />
    <ProjectReference Include="..\..\..\EGO Engine Library\EgoEngineLibrary.csproj" />
  </ItemGroup>

  <!-- Which game build a package was made against. Linked from Shared rather
       than copied, because three packagers stamp it into mod.serps and they have
       to agree on how a build is spelled - they did not, and a version nobody can
       compare records nothing. Linked here rather than in the app project
       because the packager is Core's; the Grid Editor's Core reads it through
       its reference to this one. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\GameFileGuard.cs" Link="GameFileGuard.cs" />
    <Compile Include="..\..\..\Shared\GameDatabaseSource.cs" Link="GameDatabaseSource.cs" />
    <Compile Include="..\..\..\Shared\GameVersion.cs" Link="GameVersion.cs" />
  </ItemGroup>

</Project>
