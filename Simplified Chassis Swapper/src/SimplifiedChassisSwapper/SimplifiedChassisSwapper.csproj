<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedChassisSwapper</RootNamespace>
    <AssemblyName>Simplified Chassis Swapper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded rather than shipped loose (the Studio ships a copy because it
         loads the file at runtime). Embedding gives the exe its icon and WPF
         picks it up for the window too, so the release stays a single file. -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedChassisSwapper.Core\SimplifiedChassisSwapper.Core.csproj" />
  </ItemGroup>

  <!-- No external tools are shipped: the swap works on the ERP directly and
       never shells out to texconv. tools/ holds dev harnesses only, so it must
       not be globbed in here — that would sweep their source and bin/obj into
       the release. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <!-- The native libraries as files rather than embedded. Bundling them inside
       the single-file exe means the host extracts them to %TEMP%\.net at
       startup: outside the app folder, once per build, and never cleaned up.
       MoveNativesIntoRuntimeFolder tidies them into one folder afterwards, and
       Shared\NativeLibraryFolder.cs is the other half - nothing looks in a
       subfolder by default, so the app has to say where they went. -->
  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
  </Target>

  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
  </ItemGroup>

</Project>
