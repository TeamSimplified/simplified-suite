<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- What the app reports for its version, alongside the commit it was
         built from, so a release tag can be checked against the binary. -->
    <Version>1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Simplified Studio</Company>
    <Copyright>Portions ported from EgoEngineLibrary (MIT) — © ryder25</Copyright>
  </PropertyGroup>
</Project>
