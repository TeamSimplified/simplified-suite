<Window x:Class="SimplifiedSponsorEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Sponsor Editor"
        Width="1180" Height="820" MinWidth="940" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- A rule between the mark and the document. Without it the
                     version pill and the project name read as one run of text. -->
                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" Name="ProjectLabel" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="No project open"/>
                <TextBlock DockPanel.Dock="Left" Name="DirtyLabel" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                           Visibility="Collapsed" Text="unsaved changes"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <!-- A full-height rule, as in Studio: no Height of its own, so it
                     runs the depth of the bar's content rather than floating a
                     22px stub in the middle of it. -->
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1"
                        Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Left" Name="NewButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconNew}" Click="New_Click"
                        ToolTip="New project"/>
                <Button DockPanel.Dock="Left" Name="OpenButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconOpen}" Click="Open_Click" Margin="6,0,0,0"
                        ToolTip="Open a project"/>
                <!-- Save, not Save as: a project has a file of its own and this
                     writes to it. Ctrl+Shift+S still saves as. -->
                <Button DockPanel.Dock="Left" Name="SaveButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSave}" Click="Save_Click" Margin="6,0,0,0"
                        IsEnabled="False" ToolTip="Save the project    (Ctrl+Shift+S saves as…)"/>

                <!-- Right-docked, so the first declared sits furthest right. The
                     gap between two buttons is the right-hand one's LEFT margin,
                     so the leftmost carries none.

                     Close is the project, not the app. The window's own X shuts
                     the app, and a second button doing that would sit beside one
                     that doesn't.

                     Padding and margin are Studio's, not the theme's defaults:
                     12,7 and a 6px gap. Every bar in the suite should be the
                     same height, and the theme's 12,5 makes one that is 4px
                     shorter than the apps this is meant to sit beside. -->

                <Button DockPanel.Dock="Right" Name="CloseProjectButton" Content="Close"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False" Click="CloseProject_Click"
                        ToolTip="Put this project away and leave the window open"/>
                <Button DockPanel.Dock="Right" Name="PackageButton" Content="Package"
                        Padding="12,7" Margin="6,0,0,0" IsEnabled="False" Click="Package_Click"
                        ToolTip="Write this project out as a mod anyone can install"/>
                <Button DockPanel.Dock="Right" Name="EditProjectButton" Content="Edit project"
                        Padding="12,7" IsEnabled="False" Click="EditProject_Click"
                        ToolTip="Change the mod name and author"/>
            </DockPanel>
        </Border>

        <!-- Decals on the left, the picture on the right -->
        <Grid Grid.Row="2" Margin="18,10,18,18">
            <Grid.ColumnDefinitions>
                <!-- The picture is the pane being worked in, so it gets the
                     room. Studio's split, and its MinWidths: neither pane can
                     be dragged shut. -->
                <ColumnDefinition Width="480" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Labelled "Filter", as the ERP app labels the same thing over
                     the same kind of list. A bare box beside a list would be the
                     one control in the suite that doesn't say what it does.

                     The totals sit at the end of this row, where Studio's do. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Filter"/>
                    <TextBox Grid.Column="1" Name="SearchBox" TextChanged="Search_TextChanged"
                             ToolTip="Filter by decal or sponsor name"/>
                    <TextBlock Grid.Column="2" Name="CountLabel" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                </Grid>

                <!-- One chip rather than a checkbox, on the row Studio gives its
                     resource-type chips. Same control, same style: a filter that
                     is either on or off reads as a chip everywhere else here. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ToggleButton Name="ReplacedOnlyCheck" Content="Replaced"
                                  Style="{StaticResource FilterChip}"
                                  Checked="Search_TextChanged" Unchecked="Search_TextChanged"
                                  ToolTip="Show only the decals this project changes"/>
                </WrapPanel>

                <!-- One list, grouped by sponsor — the same shape as the ERP
                     app's resource list, which groups by source archive. There
                     is no second "all" view: every decal belongs to a sponsor,
                     so the grouping loses nothing, and a switcher between two
                     views of the same 641 rows is a control that only ever
                     answers a question nobody asked. -->
                <ListBox Name="DecalList" SelectionChanged="List_SelectionChanged"
                         MouseDoubleClick="List_DoubleClick"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,8,2" LastChildFill="True">
                                <!-- Replaced-in-this-project dot. Hidden rather
                                     than collapsed when it isn't, so names keep
                                     one left edge instead of shifting as decals
                                     are replaced. -->
                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6"
                                         Margin="2,0,8,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Accent}"
                                         ToolTip="Replaced in this project">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReplaced}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!-- Default GroupItem has HorizontalContentAlignment=Left,
                                 which collapses each row's DockPanel to its natural
                                 width. Force-stretch so a row fills the group and its
                                 selection highlight spans the list. -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <!-- A quiet label with room above it, rather than a
                                         filled band with a rule. The separation comes from
                                         the whitespace, which is what stops a long list
                                         reading as a stack of boxes. -->
                                    <StackPanel Orientation="Horizontal" Margin="6,10,6,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource TextDisabled}"/>
                                        <!-- The count stamped on each row, not the group's own
                                             ItemCount, so the total stays what the sponsor has
                                             rather than what the filter left showing. -->
                                        <TextBlock Text="{Binding Items[0].SponsorSummary}"
                                                   Foreground="{DynamicResource TextDisabled}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>

            <!-- The splitter's grab area supplies the gap between the panes, so
                 neither side carries a margin of its own. The line wants air
                 either side or it reads as an edge of the list rather than as a
                 divider: 28 puts 14 either side, near the 18 the page itself is
                 inset by. -->
            <GridSplitter Grid.Column="1" Width="28"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ShowsPreview="False"/>

            <DockPanel Grid.Column="2">
                <!-- Declared first, so it docks furthest down: the actions sit
                     below the panel, on the page rather than inside a box, which
                     is where Studio's Export and Import sit. At the size Studio
                     gives them — 22,8 with an 8px gap, the primary in SemiBold. -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Name="ImportButton" Content="Import"
                            Padding="22,8" FontWeight="SemiBold"
                            IsEnabled="False" Click="Import_Click"
                            ToolTip="Choose a PNG to put on this decal"/>
                    <Button DockPanel.Dock="Left" Name="RevertButton" Content="Revert"
                            Padding="22,8" Margin="8,0,0,0"
                            IsEnabled="False" Click="Revert_Click"
                            ToolTip="Drop this replacement and go back to the game's own artwork"/>
                </DockPanel>

                <!-- What this decal is, in a panel of its own — the block Studio
                     puts its metadata in, at the same 0,8 / 10 spacing. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}"
                        Margin="0,8,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Name="DecalInfoLabel" Style="{StaticResource Hint}"/>
                        <TextBlock Name="ReplacedLabel" Margin="0,4,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                </Border>

                <!-- The judging ground, as Studio has it: slide from a light
                     backdrop to a dark one. A white logo vanishes on white and
                     a dark one on black, so neither end can be the only one on
                     offer.

                     Hidden while the pane is empty: there is nothing to judge,
                     and Studio's bars are collapsed in that state too. -->
                <Border DockPanel.Dock="Bottom" Name="BackdropBar" Style="{StaticResource Panel}"
                        Margin="0,6,0,0" Padding="8,4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Background" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <Slider Name="BackdropSlider" Style="{StaticResource BackdropSlider}"
                                Width="130" VerticalAlignment="Center"
                                ValueChanged="Backdrop_Changed"
                                ToolTip="Slide from a light background to a dark one — a light logo reads against dark, a dark one against light"/>
                    </StackPanel>
                </Border>

                <!-- The same panel Studio's preview sits in, named as Studio
                     names it: shared style for the radius and the border, and a
                     background set from code — the slider's colour while a
                     picture is up, the themed surface otherwise, so the empty
                     state isn't left sitting on a judging colour. -->
                <Border Name="PreviewSurface" Style="{StaticResource Panel}"
                        Background="{DynamicResource SurfaceSunken}">
                    <Grid>
                        <Image Name="PreviewImage" Margin="12" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Name="PreviewPlaceholder" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Select a decal"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
