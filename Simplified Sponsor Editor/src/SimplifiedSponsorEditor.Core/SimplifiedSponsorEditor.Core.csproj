<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimplifiedSponsorEditor.Core</RootNamespace>
    <AssemblyName>SimplifiedSponsorEditor.Core</AssemblyName>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    No archive or texture code of its own. Reading the sponsor archives,
    encoding a PNG into one and merging the result into a shader package are all
    EgoEngineLibrary operations this calls with paths.

    No image library either, which is why this is still plain net10.0 rather
    than net10.0-windows: letterboxing a decal onto the menu thumbnail's aspect
    happens where the artwork is chosen, so what reaches the packager is always
    a PNG that texconv can take as it is. Artwork/RasterParts works on pixels
    the app has already read, as plain bytes, which is what lets it be run from
    a console with nothing on screen.
  -->
  <!--
    GameFileGuard and GameVersion were compiled in here from Shared until this
    started referencing the Team Editor's Core, which compiles the same two and
    makes them public. Two copies of one public type in one compilation is a
    warning per use and a coin toss over which one wins, so they come from
    there now — the same files either way, since both point at Shared.
  -->

  <!-- The two resources the game wants in every mod that ships a shader
       package. One file in Shared, embedded by each packager that needs it;
       SerpsOverlay reads it back out. It stays compiled in here because it is
       internal, so each assembly that uses it needs its own — and an internal
       type cannot collide with the Team Editor's copy the way the public two
       did. LogicalName is pinned so the lookup does not depend on this
       assembly's namespace. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\Shared\serps.erp" LogicalName="serps.erp" Condition="Exists('..\..\..\Shared\serps.erp')" />
    <Compile Include="..\..\..\Shared\SerpsOverlay.cs" Link="SerpsOverlay.cs" />
  </ItemGroup>

  <!--
    The language files, and the one reader that writes them back the way the
    rest of the suite does. The Team Editor's LngFile rather than a second
    implementation: the Grid Editor already borrows it for the same reason, and
    a mod's .lng has to come out the way the Launcher expects to merge it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\EGO Engine Library\EgoEngineLibrary.csproj" />
    <ProjectReference Include="..\..\..\Language Library\SimplifiedLanguage.csproj" />
    <ProjectReference Include="..\..\..\Simplified Team Editor\src\SimplifiedTeamEditor.Core\SimplifiedTeamEditor.Core.csproj" />
  </ItemGroup>

</Project>
