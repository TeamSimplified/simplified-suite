<Project>

  <!-- MSBuild stops at the first Directory.Build.props it finds on the way up,
       so this file would replace the suite-wide one rather than adding to it.
       Importing it explicitly is the way to have both. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- What the app reports for its version, alongside the commit it was
         built from, so a release tag can be checked against the binary. 3.0:
         the first build as part of the suite, after 2.2 on its own. -->
    <Version>3.1</Version>

    <!-- The two the root sets differently. Declared after the import, so these
         win. -->
    <Company>Simplified Studio</Company>
    <Copyright>Portions ported from EgoEngineLibrary (MIT) - (c) ryder25; 3D model importing and exporting and reading the game's 3D format from Jefry's Model Handler</Copyright>
  </PropertyGroup>

</Project>
