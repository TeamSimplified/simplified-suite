<Window x:Class="SimplifiedUniversalExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Universal Exporter" Height="640" Width="1000"
        FontFamily="Segoe UI" FontSize="13"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        WindowState="Maximized">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click
         to maximise. CaptionHeight matches the bar below so Windows treats
         it as the caption; the buttons opt out via IsHitTestVisibleInChrome
         (built into the CaptionButton style). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Expander drawn with a bare rotating chevron instead of the
             stock circled arrow, on the palette. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="18,11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                                                  Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Foreground"
                                                        Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Title bar: the name and the caption buttons, nothing else. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}"
                Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The caption buttons are declared first, before anything on
                     the left, because a DockPanel hands out space in declaration
                     order and not by side: declared last, they are the first
                     thing to lose it when the window narrows. Reverse visual
                     order, as Dock=Right resolves outward-in. -->
                <Button DockPanel.Dock="Right" x:Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" x:Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" x:Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>

                <!-- The wordmark, from the shared library; the mark and the name
                     share a baseline, the pill simply centres. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Universal Exporter"/>
                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <!-- Which ERP is open, the way Studio names the open project up
                     here. Only one of the two is ever showing. -->
                <TextBlock x:Name="ErpNameLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,10,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           MinWidth="0" MaxWidth="520" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="NoErpLabel" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextDisabled}"
                           Text="No ERP open"/>
            </DockPanel>
        </Border>
        <!-- Action bar, laid out the way the rest of the suite's is: settings
             and the view on the left, what the app does on the right. -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="18,12,18,12">
            <Button DockPanel.Dock="Left" x:Name="SettingsButton" Style="{StaticResource IconButton}"
                    Tag="{StaticResource IconSettings}" Click="Settings_Click"
                    ToolTip="Settings"/>
            <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="10,0"
                    VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

            <Button DockPanel.Dock="Left" x:Name="SidebarToggleButton"
                    Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Width="36"
                    ToolTip="Show / hide the side tab"
                    Click="OnToggleSidebarClick"
                    Margin="0,0,6,0" />

            <Button DockPanel.Dock="Left" x:Name="Mode2DButton"
                    Content="2D"
                    ToolTip="2D view: one texture flat (the side tab picks which; UV view overlays its wireframe)."
                    Click="OnMode2DClick"
                    Margin="0,0,4,0" />
            <Button DockPanel.Dock="Left" x:Name="Mode3DButton"
                    Content="3D"
                    ToolTip="3D view: the rendered model (the side tab lists the ERP's models)."
                    Click="OnMode3DClick" />

            <!-- Hairline between the view-mode cluster and the file
                 actions (the Studio project bar's separator). -->
            <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="10,0"
                    VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

            <Button DockPanel.Dock="Left" x:Name="LoadErpButton"
                    Content="Open ERP"
                    Width="140"
                    Click="OnLoadErpClick"
                    Margin="0,0,5,0" />

            <!-- No game folder here: it is the same answer every time, so it
                 lives in Settings like the rest of the suite's. -->

            <!-- Reverse visual order: DockPanel resolves Dock=Right outward-in. -->
            <Button DockPanel.Dock="Right" x:Name="CloseErpButton"
                    Content="Close"
                    Width="90"
                    IsEnabled="False"
                    ToolTip="Close the open ERP and clear the viewport."
                    Click="OnCloseErpClick" />
            <Button DockPanel.Dock="Right" x:Name="ExportFbxButton"
                    Content="Export"
                    Width="90"
                    Margin="0,0,6,0"
                    IsEnabled="False"
                    Click="OnExportFbxClick" />
        </DockPanel>

        <!-- The view/load options live on the bottom bar, beside the
             Activity Log header (see below). Hidden helpers stay here. -->
        <StackPanel DockPanel.Dock="Top" Visibility="Collapsed">
            <CheckBox x:Name="OnlyLod0CheckBox"
                      Content="Only LOD0 (highest detail)"
                      IsChecked="True"
                      Visibility="Collapsed" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="18,5">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}"
                       Text="Pick an F1 25 ERP to begin." />
        </Border>

        <!-- Live activity log. Collapsed by default so it doesn't
             eat the viewport on small screens. Toggle to see what
             the app is doing (extraction progress, loads, cache
             clears, mipmaps lookups, etc.). -->
        <Grid DockPanel.Dock="Bottom">
            <Expander x:Name="LogExpander"
                  Header="Activity Log"
                  IsExpanded="False"
                  MaxHeight="180">
            <ScrollViewer x:Name="LogScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="{DynamicResource SurfaceSunken}">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         Background="{DynamicResource SurfaceSunken}"
                         Foreground="{DynamicResource TextMuted}"
                         FontFamily="Consolas"
                         FontSize="11"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalAlignment="Stretch"
                         Padding="6,4,6,12" />
            </ScrollViewer>
            </Expander>

            <!-- View / load options: pinned to the Activity Log header
                 line, ending at the viewport's right edge. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Height="40" Margin="0,0,18,0">
                <!-- Hidden but live: assembly stays on by default and the
                     load pipeline still consults it. -->
                <CheckBox x:Name="AssembleCheckBox"
                          Content="Assemble"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          ToolTip="Apply the IDF's ?render node-graph transforms so multi-part assets (cars, drivers) sit at their correct world positions."
                          Click="OnAssembleToggle" />

                <CheckBox x:Name="UvViewCheckBox"
                          Content="UV view"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="0,0,0,0"
                          ToolTip="Overlay each texture's UV wireframe onto the car so you can see exactly where every UV island lands on the model. Toggle off to restore the clean textures."
                          Click="OnUvViewToggle" />

                <CheckBox x:Name="UntexturedCheckBox"
                          Content="Untextured"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Margin="14,0,0,0"
                          ToolTip="Swap every material for a flat grey so the geometry is visible without any texture confusion. Toggle off to restore textures."
                          Click="OnUntexturedToggle" />

                <CheckBox x:Name="DecalZFightCheckBox"
                          Content="Fix decal z-fighting"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="14,0,0,0"
                          Visibility="Collapsed"
                          Click="OnSettingChanged"
                          ToolTip="Push decal / logo / overlay meshes ~0.5 mm out along their normals so they sit just in front of the base body, avoiding the flickering overlap you'd otherwise see in Blender / Maya." />

                <TextBlock x:Name="GenderLabel" Text="Gender:" VerticalAlignment="Center"
                           Margin="14,0,4,0" Visibility="Collapsed" />
                <ComboBox x:Name="GenderComboBox" Width="80" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          SelectionChanged="OnSettingChanged"
                          ToolTip="Some ERPs (race suits, drivers) ship both male and female variants. Pick one to avoid stacked overlap.">
                    <ComboBoxItem Content="Male" IsSelected="True" />
                    <ComboBoxItem Content="Female" />
                    <ComboBoxItem Content="Both" />
                </ComboBox>

                <TextBlock x:Name="ContextLabel" Text="Context:" VerticalAlignment="Center"
                           Margin="14,0,4,0" Visibility="Collapsed" />
                <ComboBox x:Name="ContextComboBox" Width="160" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          DisplayMemberPath="Label"
                          ToolTip="Each car ERP ships per-driver-number livery bindings (context=N). Pick a driver number to load that specific number atlas, or 'Auto' to let the loader pick the first available. Populated after you open the ERP."
                          IsEnabled="False"
                          SelectionChanged="OnContextSelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- Sidebar + viewport share a Grid so the user can drag
             the vertical divider to widen the model list. -->
        <Grid Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="140" />
                <ColumnDefinition x:Name="SplitterColumn" Width="10" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

        <!-- Left-side sidebar: list of IDF "models" the ERP unpacked
             into. Each entry is a checkbox; only checked items are
             loaded into the viewport and exported. Hidden until the
             first ERP load populates it. Useful mainly for track ERPs
             which contain dozens of distinct models (buildings, kerbs,
             trees, etc.) where you only want one or two at a time. -->
        <Border Grid.Column="0" x:Name="SidebarPanel" Style="{StaticResource Panel}" Padding="4">
          <Grid>
            <DockPanel x:Name="ModelsPane">
                <StackPanel DockPanel.Dock="Top" Margin="6">
                    <TextBlock Text="Models in ERP" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="SelectAllModelsButton"
                                Content="All"
                                Margin="0,0,4,0"
                                Click="OnSelectAllModelsClick" />
                        <Button x:Name="SelectNoneModelsButton"
                                Content="None"
                                Margin="0,0,4,0"
                                Click="OnSelectNoneModelsClick" />
                        <Button x:Name="ReloadSelectedButton"
                                Content="Reload Preview"
                                Click="OnReloadSelectedClick"
                                ToolTip="Re-render the viewport using only the currently-ticked models." />
                    </StackPanel>
                    <TextBlock x:Name="ModelsHintText"
                               Text="(Load an ERP)"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
                <!-- Two-level tree: IDF folders at the top, distinct
                     part names (harvested from the loader on first
                     load) as collapsible children. Both levels carry
                     a checkbox; unticking either filters the next
                     Reload Preview. The Parts list is empty until
                     the first load fills it in. -->
                <TreeView x:Name="ModelsTreeView"
                          Margin="6,0,6,6"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimary}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Parts}">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding DisplayName}"
                                      ToolTip="{Binding FolderPath}"
                                      Margin="0,4"
                                      HorizontalContentAlignment="Left" />
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding DisplayName}"
                                              Margin="0,4" />
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- 2D mode: the texture selector takes the tab over. -->
            <DockPanel x:Name="TexturesPane" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="6">
                    <TextBlock Text="Textures" FontWeight="Bold" />
                    <TextBlock x:Name="TexturesHintText"
                               Text="Pick a texture to view it flat."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
                <ListBox x:Name="Texture2DList"
                         Margin="6,0,6,6"
                         SelectionChanged="OnTexture2DSelectionChanged" />
            </DockPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="2">
            <h:HelixViewport3D x:Name="Viewport"
                               Background="Black"
                               ShowCoordinateSystem="True"
                               CoordinateSystemHorizontalPosition="Left"
                               CoordinateSystemVerticalPosition="Bottom"
                               CoordinateSystemLabelForeground="White"
                               ShowViewCube="False"
                               ZoomExtentsWhenLoaded="True">
                <h:DefaultLights />
            </h:HelixViewport3D>

            <!-- DirectX 11 high-quality renderer (ShowroomDx engine from
                 Jefry's Model Handler, neutral rig): fronts the normal
                 textured view; the WPF viewport above still serves the
                 analysis modes (UV view / Untextured) and acts as the
                 no-GPU fallback. -->
            <hx:Viewport3DX x:Name="DxViewport"
                            Visibility="Collapsed"
                            BackgroundColor="Black"
                            MSAA="Four"
                            ShowCoordinateSystem="False"
                            ViewCubeHorizontalPosition="0.9"
                            ViewCubeVerticalPosition="-0.9" />

            <!-- 2D mode: the selected texture flat on the sunken
                 surface. Fronts instead of the two 3D viewports. -->
            <Border x:Name="View2D" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceSunken}">
                <Image x:Name="Texture2DImage" Stretch="Uniform"
                       Margin="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Camera controls overlaid top-right of the model view.
                 Semi-transparent so they don't fight the render. -->
            <StackPanel x:Name="CameraButtonsPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0"
                        Orientation="Vertical">
                <Button x:Name="ResetViewButton"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconResetView}"
                        Margin="0,0,0,6"
                        ToolTip="Reset the camera to the default 3/4 front view."
                        Click="OnResetViewClick" />
                <Button x:Name="ZoomInButton"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconZoomIn}"
                        Margin="0,0,0,6"
                        ToolTip="Zoom in."
                        Click="OnZoomInClick" />
                <Button x:Name="ZoomOutButton"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconZoomOut}"
                        ToolTip="Zoom out."
                        Click="OnZoomOutClick" />
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" x:Name="SidebarSplitter"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Cursor="SizeWE"
                      Focusable="False"
                      Panel.ZIndex="999" />
        </Grid>
    </DockPanel>
</Window>
