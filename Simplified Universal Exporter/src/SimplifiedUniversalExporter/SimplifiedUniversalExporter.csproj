<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedUniversalExporter</RootNamespace>
    <AssemblyName>Simplified Universal Exporter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- As in the Core: the ported code has neither, and spells its usings. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off deliberately. Turning it on embeds the native libraries in the
         single file, and the host then extracts them to %TEMP%\.net at startup:
         once per build, never cleaned up, and outside the app folder — which
         this app does not do. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- WebView2's API docs (Microsoft.Web.WebView2.*.xml) would otherwise land
         loose beside the exe and fail release.ps1's file check. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedUniversalExporter.Core\SimplifiedUniversalExporter.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <!-- The 3D views (Helix's WPF viewport for the analysis modes, its DirectX
       one for the showroom) and Assimp, which writes the FBX. -->
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" />
    <PackageReference Include="AssimpNet" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- The RM Renderer's page, served to WebView2 from memory. -->
  <ItemGroup>
    <EmbeddedResource Include="ShowroomWeb\*" LogicalName="ShowroomWeb.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\icon.ico" Link="runtime\icon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- After publish the only loose .dlls are the natives the single file
       can't carry - WPF's own, Assimp's and WebView2's loader. Anything a
       package drops under x64\ is kept; x86\ is an architecture this app
       never runs as. WebView2 also leaves a second copy of its loader under
       runtimes\win-x64\native\; the one moved into runtime\ is the one the
       app loads (NativeLibraryFolder), so that folder goes. -->
  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
      <PublishedNativeLibrary Include="$(PublishDir)x64\*.dll"/>
      <UnusedArchitectureNative Include="$(PublishDir)x86\**\*"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
    <Delete Files="@(UnusedArchitectureNative)"/>
    <RemoveDir Directories="$(PublishDir)x64;$(PublishDir)x86;$(PublishDir)runtimes"/>
  </Target>

</Project>
