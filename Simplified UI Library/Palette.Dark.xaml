<!--
    Dark palette. Merged by App.xaml ahead of Theme.xaml, which names colours
    only through these keys — so the two files are interchangeable and adding a
    third is just another set of the same keys.

    Surfaces are neutral grey. They carried a slight blue cast, which read as a
    tint over the whole app; each is now the grey of the same perceived
    lightness, so every contrast measured against them still holds. None of them
    is black: a full-black ground makes the panel borders vanish and
    turns every drop shadow into nothing. Text tops out below pure white for the
    same reason in reverse — #FFFFFF on a dark ground reads as glare over a long
    session.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SurfaceColor">#FF1E2228</Color>
    <Color x:Key="AccentColor">#FF5B9BD5</Color>

    <SolidColorBrush x:Key="Surface"       Color="#222222"/>
    <SolidColorBrush x:Key="SurfaceAlt"    Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BorderSoft"    Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BorderStrong"  Color="#515151"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#EAEAEA"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#A4A4A4"/>
    <SolidColorBrush x:Key="TextDisabled"  Color="#666666"/>

    <!-- Lifted from the light accent: #3D6FA8 has too little contrast against a
         dark ground to read as the highlight colour. -->
    <SolidColorBrush x:Key="Accent"        Color="#5B9BD5"/>
    <SolidColorBrush x:Key="AccentSoft"    Color="#2B3B4D"/>
    <SolidColorBrush x:Key="Hover"         Color="#353535"/>
    <SolidColorBrush x:Key="Pressed"       Color="#404040"/>

    <!-- List selection. Neutral on purpose: the resource list sits beside the
         preview, and a saturated tint there shifts how the artwork next to it
         reads. Accent stays for controls that are switched on. -->
    <!-- Pill fill for the title-bar version badge. A step darker than
         SurfaceSunken, which the resource pills use: those sit on the white
         list, where a light fill reads, while this one sits on SurfaceAlt and
         separated from it by only 1.05:1 — invisible. Its text is TextPrimary
         rather than TextMuted, since darkening the fill alone would drop the
         muted text to 3.86:1. -->
    <SolidColorBrush x:Key="Badge"        Color="#3C3C3C"/>

    <SolidColorBrush x:Key="Selected"      Color="#414141"/>

    <!-- Selection where selection is the point, which is a table: a cell is
         picked in order to edit it or delete its row, and on a page of grey
         rows the grey mark above is the hardest thing to find. Blue enough to
         spot at a glance, dark enough to leave TextPrimary readable on it. -->
    <SolidColorBrush x:Key="SelectedAccent" Color="#2F4A66"/>

    <!-- Brightened so it still reads as a warning against dark, where the light
         theme's #C42B1C goes muddy. -->
    <SolidColorBrush x:Key="Danger"        Color="#E04434"/>

    <!-- The wordmark in white, at full contrast rather than following body text. -->
    <SolidColorBrush x:Key="BrandInk"      Color="#FFFFFF"/>

    <!-- JSON and XML previews. Punctuation is left to TextMuted so the
         structure recedes and the content carries the colour. -->
    <SolidColorBrush x:Key="SyntaxKey"     Color="#9CDCFE"/>
    <SolidColorBrush x:Key="SyntaxString"  Color="#CE9178"/>
    <SolidColorBrush x:Key="SyntaxNumber"  Color="#B5CEA8"/>
    <SolidColorBrush x:Key="SyntaxTag"     Color="#4EC9B0"/>
    <SolidColorBrush x:Key="SyntaxComment" Color="#6A9955"/>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="#C586C0"/>

</ResourceDictionary>
