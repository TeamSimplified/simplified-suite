<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The suite's look: the control styles, the three palettes, the theme switch,
    and the frameless dialog chrome.

    Studio and ERP each carried a copy. They agreed on everything except the
    wordmark, which stays with each app as its own Brand.xaml - so this is the
    styles, and nothing that is one app's.

    net10.0-windows with WPF, because resource dictionaries and Window chrome
    are WPF types, and everything that consumes this is a WPF app.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedUi</RootNamespace>
    <AssemblyName>SimplifiedUi</AssemblyName>
    <!-- Four apps depend on this, so a change here reaches all of them. Say
         which build it is, the way the apps already do. -->
    <Version>1.0</Version>
  </PropertyGroup>

  <!-- The minimise animation, linked rather than copied: the launcher draws its
       own chrome without any of this library and needs the same fix, so there is
       one file and two consumers instead of two files that agree until they
       don't. -->
  <ItemGroup>
    <Compile Include="..\Shared\MinimiseAnimation.cs" Link="MinimiseAnimation.cs" />
  </ItemGroup>

</Project>
