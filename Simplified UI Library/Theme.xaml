    <!-- ─────────────── Preview backdrop ───────────────
         What sits behind the previewed image, set by the slider on the channel
         bar. Deliberately not palette keys: these are a judging surface, not
         chrome. A light artwork is read against dark and a dark one against
         light, so the pair has to stay available whichever theme the app itself
         is wearing.

         These are the two ends of the slider, which mixes between them.
         BackdropSlider repeats them as gradient stops, since a
         LinearGradientBrush cannot reference resources for its stops. -->
    <SolidColorBrush x:Key="PreviewBackdropLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PreviewBackdropDark"  Color="#1E1E1E"/>

    <!-- ─────────────── Window caption ───────────────
         Shared by the main window and every code-built dialog, which see
         application resources only. -->
    <!-- Title-bar buttons: flat, no border, tinted on hover. Close goes red
         on hover the way every Windows app does. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Icon buttons ───────────────
         A square button carrying a Material icon. The icon is a Path tinted from
         the palette, so it follows the theme the way the wordmark does, and the
         template owns it rather than taking Content — a ContentPresenter would
         hand a string to the implicit TextBlock style and lose the tint. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <!-- Tag carries the geometry, so one style serves every icon. -->
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Glyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="{TemplateBinding Foreground}"/>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Backdrop slider ───────────────
         Sets what sits behind the previewed image, anywhere between the two
         ends rather than at one or the other.

         The track is painted with the very gradient it selects from, so the
         control shows what it does without a label. The gradient is stated here
         rather than bound to the two backdrop brushes: a LinearGradientBrush
         can't take resource references for its stops, so the ends are repeated
         from PreviewBackdropLight/Dark and have to be kept in step with them. -->
    <Style x:Key="BackdropThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Knob" CornerRadius="7"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BackdropSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="SmallChange" Value="0.05"/>
        <Setter Property="LargeChange" Value="0.2"/>
        <!-- Click the track to jump there, rather than stepping towards it. -->
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16" VerticalAlignment="Center">
                        <Border Height="8" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FFFFFF"/>
                                    <GradientStop Offset="1" Color="#1E1E1E"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BackdropThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An ordinary slider, for a number rather than for a colour.

         BackdropSlider draws its own gradient because the track *is* the thing
         being chosen. Here the track is a track: a hairline groove with the part
         behind the thumb filled in, so how far along it sits is readable without
         looking at the number beside it.

         The same thumb as the backdrop one, deliberately. A slider should be the
         same object to grab wherever it turns up in the suite, and the only
         thing that differs between these two is what is under it. -->
    <Style x:Key="ValueSlider" TargetType="Slider">
        <!-- Click the track to jump there, rather than stepping towards it. -->
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceSunken}"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <!-- The filled part. A RepeatButton because that
                                     is what the Track gives the space before the
                                     thumb; it keeps the click-to-page behaviour
                                     and happens to be the right shape to paint. -->
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Accent}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BackdropThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Panels ───────────────
         One style for every framed section, so they can't drift apart again:
         the preview, the bars under it and the metadata block were square while
         the list beside them was rounded.

         6px matches the resource list. Controls — buttons, text boxes — stay at
         4: a container and the things inside it shouldn't share a radius, or the
         nesting stops reading. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ─────────────── Splitter ───────────────
         The grab area is wider than the line it draws: a 1px target is miserable
         to hit, so the control is wide and transparent with a hairline centred
         in it. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="Line" Width="1" HorizontalAlignment="Center"
                                Background="{DynamicResource BorderSoft}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Chips ───────────────
         Small pills for the resource-type filter and the preview channels. Both
         share one template; the difference is only the control type, which is
         what decides the behaviour. ToggleButtons let any combination of types
         be on at once, while RadioButtons in one panel are mutually exclusive
         and can't all be turned off — exactly right for a view mode, where
         "no channel" would mean nothing. -->
    <ControlTemplate x:Key="ChipTemplate" TargetType="ToggleButton">
        <Border x:Name="Chrome" CornerRadius="10"
                Background="{DynamicResource SurfaceSunken}"
                BorderBrush="Transparent" BorderThickness="1"
                Padding="{TemplateBinding Padding}">
            <!-- A TextBlock rather than a ContentPresenter: a presenter generates
                 its own TextBlock for string content, and the implicit TextBlock
                 style paints that TextPrimary — which beats anything inherited
                 from the chip, so the checked state's foreground never reached
                 the label. Template-binding it here makes it a template value,
                 which the style setter cannot override.

                 The cost is that chips carry text only. That is all they hold,
                 and a chip is a word by definition. -->
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
            <!-- The accent carries the tint and the outline; the label stays text
                 colour. Coloured text at this size reads as decoration rather than
                 as a state, and the fill already says the chip is on. -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Template" Value="{StaticResource ChipTemplate}"/>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChannelChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Template" Value="{StaticResource ChipTemplate}"/>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Text ─────────────── -->
    <Style TargetType="Label">
        <Setter Property="Margin" Value="0,2,8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ─────────────── Tooltips ───────────
         Stock tooltips fill from SystemColors.InfoBrushKey, which is Windows'
         colour and not ours, so they stayed light when the palette went dark.

         The text takes its colour through the ContentPresenter, which builds a
         TextBlock for string content and hands it to the implicit TextBlock
         style above — the same path that caught the chips out, except here it
         lands on the right answer, since that style names TextPrimary and this
         wants exactly that. Setting Foreground on the ToolTip itself would be
         the thing that does not work: the generated TextBlock beats it. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Buttons ───────────────
         Flat with a soft border and a 6px radius. The stock button's gradient
         and 3D edge are what date the app most. -->
    <!-- ─────────────── Right-click menus ───────────
         The stock ContextMenu and MenuItem fill from system brushes, so they
         stayed light in dark mode. Two menus are affected: the category-header
         menu Studio builds, and the Cut/Copy/Paste menu WPF puts on the text
         preview by itself - an implicit style catches both. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter SnapsToDevicePixels="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                            Margin="2,1" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- A TextBlock the template owns, not a ContentPresenter:
                                 a presenter builds its own for string content and the
                                 implicit TextBlock style repaints it, so the disabled
                                 colour below would never land. Header must therefore
                                 be text, which is all either app uses. A full Binding
                                 rather than TemplateBinding, since Header is typed as
                                 object and only a Binding converts it. -->
                            <TextBlock x:Name="Label" VerticalAlignment="Center"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="Gesture" Grid.Column="1" VerticalAlignment="Center"
                                       Margin="24,0,0,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two declarations for one look. A menu does not use the implicit
         Separator style: it asks for the one keyed MenuItem.SeparatorStyleKey,
         and without that key it gets the theme's own - #D7D7D7, which is what
         was still showing light inside an otherwise dark menu. The alias below
         points that key at this style. -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource {x:Type Separator}}"/>

    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pressed}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- A disabled control is still hit-tested, so without
                                 this the hand appears over a button that does nothing. -->
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Text input ───────────────
         Padding and vertical centring carry over from the styles this replaces,
         so nothing in the layout shifts. -->
    <Style TargetType="TextBox">
        <!-- The little square where the two scrollbars meet belongs to WPF's own
             ScrollViewer template, which fills it from SystemColors.Control -
             #F0F0F0, i.e. a white tile in the corner of every dark-mode box with
             both bars showing. Transparent lets the Chrome border below show
             through instead, which is right in either palette and for whatever
             background a caller sets.

             Scoped to this style rather than declared globally: the key is a
             system brush that stock templates use for real surfaces elsewhere,
             and making all of those transparent is not the same fix. -->
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
        </Style.Resources>
        <Setter Property="Padding" Value="4,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <!-- The alignment is what centres a one-line field's text,
                             and it works by letting the host size to its content
                             rather than fill. In a multi-line box that is wrong
                             twice over: the horizontal scrollbar rides the bottom
                             of the TEXT, so it climbs the control as lines are
                             added, and the vertical bar is only as tall as what
                             it scrolls. The triggers below stretch it back. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Multi-line by either route: a box that takes Return,
                             or one that wraps. Both fill the control. -->
                        <!-- Multi-line boxes fill their frame and start at the
                             top. The Center above is right for the one-line
                             fields it was written for - a filter, a path - and
                             wrong for everything a log goes in: stretching the
                             host without moving the content left the first line
                             floating in the middle of an empty box, drifting
                             down as it filled. Both halves are needed, and the
                             second one is on the TextBox rather than the host
                             because that is what the text host reads. -->
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Trigger>
                        <Trigger Property="TextWrapping" Value="Wrap">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Trigger>
                        <Trigger Property="TextWrapping" Value="WrapWithOverflow">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The text field inside an editable ComboBox.
         Style="{x:Null}" is not an option — that takes the caret and selection
         colours with it — so this extends the TextBox style and takes its own
         chrome away instead: the ComboBox's border is already around it, and
         two nested rounded boxes is what the stock one looks like. -->
    <Style x:Key="ComboBoxEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <!-- The whole field opens the list, as a plain picker's does; once it
             has focus, clicks go back to placing the caret. -->
        <Setter Property="ui:EditableCombo.OpenOnFirstClick" Value="True"/>
    </Style>

    <!-- Stock template kept; only the colours change. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                            Margin="3,1" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!-- A presenter, unlike the chips, which own their TextBlock
                             so they can paint it differently. Here the implicit
                             TextBlock style repaints it TextPrimary, which is what
                             the item wanted anyway.

                             It has to be a presenter. A TextBlock bound with
                             TemplateBinding takes only a string, and TemplateBinding
                             runs no converter — so an item bound through
                             DisplayMemberPath, whose Content is the object, failed
                             silently and drew nothing at all. The presenter also
                             honours ItemTemplate, so what shows is the bound
                             property rather than ToString(). -->
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Two columns, though only the editable case uses
                                 them: the text box takes the first, leaving the
                                 arrow's column to the toggle underneath. With
                                 the text box spanning the whole width it covered
                                 the arrow and swallowed its clicks, which left
                                 the 8px of padding at the edges as the only
                                 place the list would open from. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>

                            <!-- The whole box is the button: the toggle sits under the
                                 content with no chrome of its own. -->
                            <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Spans both columns: a plain ComboBox has no text
                                 box, so its selected item may use the full width. -->
                            <ContentPresenter x:Name="Selection" Grid.ColumnSpan="2" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <!-- Where an editable ComboBox puts its text. ComboBox
                                 finds it by this exact name in OnApplyTemplate;
                                 without one, IsEditable has nowhere to draw, so
                                 setting Text shows nothing and typing does nothing.

                                 Declared after the toggle so it takes the clicks
                                 over the text; the arrow's column is left to the
                                 toggle underneath. -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Style="{StaticResource ComboBoxEditor}"
                                     Visibility="Collapsed"
                                     Margin="{TemplateBinding Padding}"
                                     Foreground="{TemplateBinding Foreground}"
                                     VerticalContentAlignment="Center"/>

                            <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L8,0 L4,5 Z" Width="8" Height="5"
                                  Fill="{DynamicResource TextMuted}" IsHitTestVisible="False"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- One or the other, never both: the presenter shows the
                             selected item, the text box shows what can be typed. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
                            <!-- A text cursor over the field it belongs to. -->
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Check box ─────────────── -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1" CornerRadius="4"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <!-- Stretch, and a size, rather than the geometry at
                                 its own coordinates. A Shape with Stretch=None
                                 measures from the origin to the far edge of its
                                 geometry, so the gap between 0,0 and the tick's
                                 first point counts as part of the element -
                                 centring that then puts the ink low and right of
                                 the box by about a pixel, which is plainly
                                 visible at 16px. Stretch fits the stroked figure
                                 to these bounds instead, so centring the element
                                 centres what you can actually see. -->
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Data="M 2,6 L 5.5,9.5 L 11,3"
                                  Stretch="Uniform" Width="10" Height="7.5"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A disabled control is still hit-tested, so without this the
                 hand would appear over buttons that do nothing. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Lists ───────────────
         The item style leaves HorizontalContentAlignment alone: the resource
         list sets Stretch on the ListBox and rows must keep filling the width. -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>

        <!-- Both grouped lists — the resource list and Choose parts — could be
             scrolled past their last row into blank space.

             A grouped list scrolls in whole groups: the extent counts group
             headers rather than rows, so the viewport measures one group, and at
             full scroll the last group is parked at the top of the view. Where
             that group is short, the rest of the view is empty — 222px of it in a
             1000-row test.

             Pixel units give the extent real heights and end the list flush.
             They only apply while the panel is virtualising, though, and grouping
             turns virtualising off unless asked, so the two settings only work as
             a pair. Virtualising again is worth having on its own: the same test
             realised every one of its 1000 rows, and 32 with these set. -->
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <!-- A row is a click target: selecting it is how the preview is chosen. -->
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="Transparent"
                            CornerRadius="5" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <!-- Selection is grey, not accent — see the Selected token.
                             Declared after the hover trigger so a selected row that is
                             also hovered keeps reading as selected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/>
                        </Trigger>
                        <!-- The row a drag is over. Declared after selection so
                             it wins over both of the states above: while a file
                             is in the air the question is where it will land,
                             not what was selected before the drag began.
                             Accent-tinted rather than accent, because the row's
                             own text still has to read on top of it. -->
                        <Trigger Property="ui:DropHighlight.IsOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Trees ───────────────
         A near-stock TreeView cannot be themed from the outside: like the
         DataGrid, it builds its chrome and its selection highlight from
         SystemColors, so it stays white on a dark palette however its
         Background is set. Both it and its rows are retemplated here rather
         than in the one app that wanted a tree first, which is where the next
         one will look.

         The expander is drawn rather than glyphed. Segoe MDL2 has arrows, but
         a Path rotates cleanly between the two states and takes its colour from
         the palette without a second brush lookup. -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8 Z"
                              Fill="{DynamicResource TextMuted}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- The whole transform is replaced rather than its
                             Angle set: a trigger can only target a named
                             element of the template, and a RotateTransform
                             hanging off one is not that. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- The row highlight spans both columns, so clicking
                             level with the arrow selects rather than missing. -->
                        <Border x:Name="Chrome" Grid.ColumnSpan="2"
                                Background="Transparent" CornerRadius="5"
                                SnapsToDevicePixels="True"/>

                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                      Style="{StaticResource TreeExpander}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <ContentPresenter x:Name="Header" Grid.Column="1"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>

                        <!-- Children indent by sitting in the second column of
                             the row below, which lines them up under the header
                             rather than under the arrow. -->
                        <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.Column="1"
                                        Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Nothing to expand, nothing to click. -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <!-- Selection is grey, not accent — see the Selected
                             token. Declared after hover so a selected row under
                             the pointer keeps reading as selected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Scroll bars ───────────────
         Slim, no arrow buttons, thumb thickens on hover. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource BorderStrong}" CornerRadius="4" Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextDisabled}"/>
                            <Setter TargetName="Bar" Property="Margin" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextMuted}"/>
                            <Setter TargetName="Bar" Property="Margin" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <!-- The cursor is NOT set here, though this is the obvious place. The
             ScrollViewer's own template sets Cursor="Arrow" on the bars it
             creates, so the value arrives as ParentTemplate, which outranks a
             style setter and a style trigger alike - only a local value beats
             it, and a style cannot set one. It goes on the Grid inside the
             template below instead: QueryCursor bubbles from whatever is under
             the pointer, so the Grid answers before the ScrollBar is asked. -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" Cursor="Hand">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" Cursor="Hand">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────────── Tabs ───────────────
         Nothing used a TabControl until the Swapper put two apps in one window,
         so the stock template was still in play - which draws its own chrome
         from system brushes and stays light whatever the palette says, the same
         reason ComboBox had to be retemplated.

         An underline rather than a raised tab: the selected one is marked by an
         accent rule under the label, which reads at a glance without the strip
         becoming another surface competing with the toolbar below it. -->
    <Style TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Under the label, inside the same cell, so the strip's
                             height does not change when the selection moves. -->
                        <Border x:Name="Rule" Height="2" VerticalAlignment="Bottom"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Rule" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
                                Padding="18,0,0,0">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1"/>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <!-- The name is not decoration: TabItemAutomationPeer
                                 looks for PART_SelectedContentHost to hand the
                                 selected tab's content to accessibility tools.
                                 Without it a screen reader sees the tab strip
                                 and nothing inside any tab. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────────── Tables ───────────────
         DataGrid is the one control here that cannot be left near-stock. It
         builds its chrome from the system brushes - SystemColors.WindowBrush
         for the surface, ControlBrush for the headers, HighlightBrush for the
         selection - so an untouched grid stays light in the dark palette and
         is the only white rectangle on screen. All four pieces are retemplated
         for the same reason ComboBox and TabItem were.

         Rows carry the colour, not cells: a cell that paints its own selection
         leaves the gaps between columns unpainted, so the row reads as striped
         rather than selected. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSoft}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- The strip carries the header colour,
                                             not the individual headers: it also
                                             covers the filler past the last
                                             column, which the stock presenter
                                             paints from a system brush. Rounding
                                             it here rather than clipping the
                                             whole grid keeps the top corners
                                             following the border above without
                                             a size-bound clip geometry.

                                             The headers scroll sideways with the
                                             rows; PART_ names are what DataGrid
                                             looks for to wire that up. -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Background="{DynamicResource SurfaceAlt}"
                                                CornerRadius="5,5,0,0">
                                            <DataGridColumnHeadersPresenter
                                                x:Name="PART_ColumnHeadersPresenter"
                                                Visibility="{Binding HeadersVisibility,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid},
                                                    Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                                    ConverterParameter={x:Static DataGridHeadersVisibility.Column}}"/>
                                        </Border>

                                        <ScrollContentPresenter Grid.Row="1" Grid.Column="0"
                                                                x:Name="PART_ScrollContentPresenter"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                        <ScrollBar Grid.Row="1" Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                                   Orientation="Vertical"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                                        <ScrollBar Grid.Row="2" Grid.Column="0" x:Name="PART_HorizontalScrollBar"
                                                   Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}"
                                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent by default: the strip behind them in the DataGrid template
         is what carries the header colour, so a header does not have to line up
         with the filler beside it. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Off unless a table turns it on, so every table that has one of
             these today looks the way it did yesterday. SeparatorBrush and
             SeparatorVisibility are the header's own properties — WPF's stock
             template uses them for the same thing, and this one ignored them
             until a table wanted a line down its columns. -->
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <!-- The edge between this column and the next. Before the
                             gripper in the tree, so the invisible drag handle
                             still sits on top of it. -->
                        <Border Width="1" HorizontalAlignment="Right"
                                Background="{TemplateBinding SeparatorBrush}"
                                Visibility="{TemplateBinding SeparatorVisibility}"/>

                        <!-- The drag handle DataGrid needs by name to resize a
                             column. Transparent and 8 wide: invisible, but wide
                             enough to grab. -->
                        <Thumb x:Name="PART_RightHeaderGripper" Width="8" Cursor="SizeWE"
                               HorizontalAlignment="Right">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <!-- PART_ name again: DataGrid finds the cells through it. -->
                        <DataGridCellsPresenter x:Name="PART_CellsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Every other line, faintly, which is what keeps the
                             eye on one row across a wide table. Only when the
                             table asks for it: AlternationIndex is 0 for every
                             row until a DataGrid sets AlternationCount, so a
                             table that says nothing is striped by nothing.

                             First of the three, so hover and selection are both
                             still visible on the shaded rows. -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/>
                        </Trigger>
                        <!-- After hover, so a selected row that is also hovered
                             keeps reading as selected. Grey rather than accent,
                             as everywhere else in the suite. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A table whose SelectionUnit is the cell selects one
                             cell at a time and leaves the row unselected, so
                             without this nothing on screen says what is chosen.
                             The same grey the row uses, for the same reason. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- The focus rectangle is the stock one and draws in a system colour;
             the row already says which line is current. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- What a cell turns into while it is being edited.
         DataGridTextColumn builds that box from its own DefaultEditingElementStyle,
         which has no BasedOn — so it replaces the themed TextBox outright and the
         cell opens white with black text in a dark window. The same gotcha the
         conventions warn about, from inside WPF itself.

         A column is not in the visual tree and an implicit style cannot reach it,
         so this one has a key and the column has to be handed it:

             <DataGridTextColumn EditingElementStyle="{StaticResource DataGridEditor}" ... />

         No chrome of its own and no padding: the cell's border and padding are
         already around it, so the text sits exactly where it was a moment ago
         rather than jumping as the editor opens. -->
    <Style x:Key="DataGridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
