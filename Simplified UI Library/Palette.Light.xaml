<!--
    Light palette. Merged by App.xaml ahead of Theme.xaml, which names colours
    only through these keys — so the two files are interchangeable and adding a
    third is just another set of the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─────────────── Palette ───────────────
         Content sits on white and regions are separated by hairline borders,
         not by grey fills. A mid-tone grey bar competes with the content it is
         supposed to frame, which is what made the old #EEF1F5 read as muddy —
         chrome here is barely tinted and does its separating with a 1px rule.
         Grey is kept for text.

         The ramp is the neutral one shared by GitHub Primer, Tailwind slate and
         Fluent 2, which is well-tested for contrast at these steps. -->
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#FF2563EB</Color>

    <SolidColorBrush x:Key="Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt"    Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderSoft"    Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrong"  Color="#CBD5E1"/>

    <!-- Near-black rather than black: pure #000 on white is harsher than any
         printed text and is not what the references use. -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#0F172A"/>
    <SolidColorBrush x:Key="TextMuted"     Color="#64748B"/>
    <SolidColorBrush x:Key="TextDisabled"  Color="#94A3B8"/>

    <SolidColorBrush x:Key="Accent"        Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoft"    Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Hover"         Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Pressed"       Color="#E2E8F0"/>

    <!-- List selection. Neutral on purpose: the resource list sits beside the
         preview, and a saturated tint there shifts how the artwork next to it
         reads. Accent stays for controls that are switched on. -->
    <!-- Pill fill for the title-bar version badge. A step darker than
         SurfaceSunken, which the resource pills use: those sit on the white
         list, where a light fill reads, while this one sits on SurfaceAlt and
         separated from it by only 1.05:1 — invisible. Its text is TextPrimary
         rather than TextMuted, since darkening the fill alone would drop the
         muted text to 3.86:1. -->
    <SolidColorBrush x:Key="Badge"        Color="#E2E8F0"/>

    <SolidColorBrush x:Key="Selected"      Color="#E2E8F0"/>

    <!-- The same thing for the light palette, and not AccentSoft: that one is
         a tint for a panel behind something, barely a step off white, and a
         selected row wearing it reads as unselected. This is the blue a list
         has always used to say "this one". -->
    <SolidColorBrush x:Key="SelectedAccent" Color="#BBDCF5"/>
    <SolidColorBrush x:Key="Danger"        Color="#DC2626"/>

    <!-- The wordmark's ink. Named separately from body text so the logo can be
         held at full contrast when the text around it isn't. -->
    <SolidColorBrush x:Key="BrandInk" Color="#0F172A"/>

    <!-- JSON and XML previews. Punctuation is left to TextMuted so the
         structure recedes and the content carries the colour.

         VS Code's Light+ values, except the two greens: measured against this
         theme's preview ground (SurfaceSunken #F1F5F9) the originals came to
         4.2:1 and 3.9:1, under the 4.5:1 wanted for text this size. Darkened to
         6.0:1 and 5.5:1. The dark palette needed no such correction. -->
    <SolidColorBrush x:Key="SyntaxKey"     Color="#0451A5"/>
    <SolidColorBrush x:Key="SyntaxString"  Color="#A31515"/>
    <SolidColorBrush x:Key="SyntaxNumber"  Color="#076B43"/>
    <SolidColorBrush x:Key="SyntaxTag"     Color="#800000"/>
    <SolidColorBrush x:Key="SyntaxComment" Color="#2A7030"/>
    <SolidColorBrush x:Key="SyntaxKeyword" Color="#7A3E9D"/>

</ResourceDictionary>
