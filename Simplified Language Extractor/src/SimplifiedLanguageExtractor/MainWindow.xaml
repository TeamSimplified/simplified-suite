<Window x:Class="SimplifiedLanguageExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Language Extractor"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows.

                     Two rules line this row up, because two different things are
                     being aligned. The mark and the name are type, so they share
                     a baseline: the mark's box carries the descender of its "p",
                     which lifts the letters half a pixel, and the margin below
                     puts them back down — doubled, since a margin against a
                     centred element moves it by half. The pill is a shape rather
                     than a line of text, so it simply centres; putting its small
                     text on the name's baseline drops the pill visibly low. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <!-- The app's name, beside the mark. The wordmark says which
                     suite this came from; without this the window never says
                     which of them it is, and they all open looking the same. -->
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Language Extractor"/>

                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" Name="SubtitleLabel" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextMuted}"
                           Text="Language files, out of the game's own exe"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <Border DockPanel.Dock="Left" Margin="10,0" Width="1"
                        Background="{DynamicResource BorderSoft}"/>

                <Button DockPanel.Dock="Right" Name="ExtractButton" Content="Extract"
                        Padding="12,7" Margin="6,0,0,0" FontWeight="SemiBold"
                        IsEnabled="False" Click="Extract_Click"
                        ToolTip="Pull every language file out of the exe"/>
                <Button DockPanel.Dock="Right" Name="ClearLogButton" Content="Clear log"
                        Padding="12,7" Click="ClearLog_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="18,10,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- No row for the exe. The game folder is already a setting, and
                 the exe is the one at the top of it - asking twice for the same
                 answer is a question that only exists to be answered. What was
                 found is said in the log, and in the line under the wordmark
                 when it wasn't. -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Write to"/>
                <TextBox Grid.Column="1" Name="OutputBox" IsReadOnly="True"
                         ToolTip="Where the .lng files are written"/>
                <Button Grid.Column="2" Name="BrowseOutputButton" Content="Browse" Padding="12,7"
                        Margin="8,0,0,0" Click="BrowseOutput_Click"/>
            </Grid>

            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource SectionHeader}"/>
                <TextBox Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Cascadia Mono"
                         FontSize="12" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
