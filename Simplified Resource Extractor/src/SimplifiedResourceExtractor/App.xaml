<Application x:Class="SimplifiedResourceExtractor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimplifiedResourceExtractor"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The suite's look, from the shared library. The palette must
                     be merged FIRST and stay first: Theme.xaml resolves its
                     colours against whatever is already in the dictionary, and
                     ThemeManager swaps this entry in place when the theme
                     changes. This is the fallback, not the decision - App
                     applies the saved one at startup. -->
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Palette.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Every keyed style says BasedOn. Without it the keyed style
                 replaces the themed template outright and drops that control
                 back to the stock Windows look, which stays light whatever the
                 palette says. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="PaneHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,3"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <!-- The shared TextBox style centres its content, which is right for
                 a one-line field and wrong for a page of writing: the rules and
                 the log both have to start at the top and grow downward. -->
            <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            </Style>

            <!-- The rules editor and its line-number gutter sit inside one
                 border of their own, so each drops the chrome the TextBox
                 template would otherwise draw around it. -->
            <Style x:Key="BareEditor" TargetType="TextBox" BasedOn="{StaticResource Editor}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!--
                The line numbers.

                A TextBox, sharing the editor's style, because the numbers have
                to sit on the same baselines as the text beside them and two
                TextBoxes with the same font agree by construction. A TextBlock
                does not: it places the baseline differently inside the line box,
                and lining the boxes up still left the digits half a row out.

                Deliberately NOT IsReadOnly. The shared template repaints the
                background SurfaceAlt when that is set, and a TargetName trigger
                inside a template cannot be overridden from outside it - the
                gutter came out as a grey stripe. Unfocusable and untouchable
                gets the same result: there is no way to put a caret in it.

                HorizontalScrollBarVisibility must be Disabled rather than
                Hidden. Hidden leaves the content scrollable, and right-aligned
                text in a box only as wide as its digits then sits scrolled out
                of sight - a gutter that draws nothing at all.
            -->
            <Style x:Key="Gutter" TargetType="TextBox" BasedOn="{StaticResource BareEditor}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="IsUndoEnabled" Value="False"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                <Setter Property="Padding" Value="8,6,6,6"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
