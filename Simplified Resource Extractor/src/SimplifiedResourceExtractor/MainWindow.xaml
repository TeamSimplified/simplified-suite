<Window x:Class="SimplifiedResourceExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Resource Extractor"
        Width="1180" Height="820" MinWidth="900" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="Resource Extractor"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>

                <!-- Right-docked, so the first declared sits furthest right. The
                     gap between two buttons is the right-hand one's LEFT margin,
                     so the leftmost carries none. -->
                <Button DockPanel.Dock="Right" Name="CloseButton" Content="Close"
                        Margin="12,0,0,0" Click="Close_Click"
                        ToolTip="Close the app"/>
                <Button DockPanel.Dock="Right" Name="CancelButton" Content="Cancel"
                        Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel_Click"
                        ToolTip="Stop the job after the archive it is on"/>
                <Button DockPanel.Dock="Right" Name="ExtractButton" Content="Extract"
                        Margin="6,0,0,0" Click="Extract_Click"
                        ToolTip="Find the matches and write them out"/>
                <Button DockPanel.Dock="Right" Name="ScanButton" Content="Scan"
                        Click="Scan_Click"
                        ToolTip="Find what matches, without writing anything"/>
            </DockPanel>
        </Border>

        <!-- Folders and options -->
        <Border Grid.Row="2" Padding="18,14,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Search in:"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Name="SearchBox" Margin="0,0,0,6"
                           ToolTip="Every .erp under this folder is looked at. Usually the game install."/>
                <Button    Grid.Row="0" Grid.Column="2" Style="{StaticResource RowButton}" Margin="6,0,0,6"
                           Content="Browse" Click="BrowseSearch_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Output to:"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Name="OutputBox"
                           ToolTip="Where the extracted archives are written."/>
                <Button    Grid.Row="1" Grid.Column="2" Style="{StaticResource RowButton}" Margin="6,0,0,0"
                           Content="Browse" Click="BrowseOutput_Click"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Name="StripCheck" Content="Strip mipmaps"
                              ToolTip="Pull each texture's full resolution in from the game's .mipmaps files, so the result stands on its own. Needs the game folder, which is in Settings."/>
                    <CheckBox Name="IndividualCheck" Content="Extract individually" Margin="22,0,0,0"
                              ToolTip="One archive per source, rather than everything merged into one"/>
                    <CheckBox Name="PrefixCheck" Content="Add folder name prefix" Margin="22,0,0,0"
                              ToolTip="Name outputs after the output folder too, for telling one run's results from another's"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules on the left, what happened on the right -->
        <Grid Grid.Row="3" Margin="18,4,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PaneHeading}" Text="RULES"/>
                    <TextBlock DockPanel.Dock="Right" Name="RulesCountLabel"
                               Style="{StaticResource PaneHeading}"/>
                </DockPanel>
                <TextBox Name="RulesBox" Style="{StaticResource Editor}"
                         TextChanged="Rules_TextChanged" LostFocus="Rules_LostFocus"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeading}" Text="LOG"/>
                <TextBox Name="LogBox" Style="{StaticResource Editor}" IsReadOnly="True"
                         Background="{DynamicResource SurfaceSunken}"/>
            </DockPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Text="Point it at a folder, write some rules, and press Scan."/>
        </Border>
    </Grid>
</Window>
