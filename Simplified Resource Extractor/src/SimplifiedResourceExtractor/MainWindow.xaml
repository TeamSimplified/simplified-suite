<Window x:Class="SimplifiedResourceExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Simplified Resource Extractor"
        Width="1180" Height="820" MinWidth="900" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Surface}"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. CaptionHeight matches the bar below so Windows treats it as the
         caption; the buttons opt out of that via IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. Viewbox with only a
                     Height: the artwork keeps its own proportions and the width
                     follows.

                     Two rules line this row up, because two different things are
                     being aligned. The mark and the name are type, so they share
                     a baseline: the mark's box carries the descender of its "p",
                     which lifts the letters half a pixel, and the margin below
                     puts them back down — doubled, since a margin against a
                     centred element moves it by half. The pill is a shape rather
                     than a line of text, so it simply centres; putting its small
                     text on the name's baseline drops the pill visibly low. -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <!-- The app's name, beside the mark. The wordmark says which
                     suite this came from; without this the window never says
                     which of them it is, and they all open looking the same. -->
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Resource Extractor"/>

                <!-- Version pill, set in code from the assembly so it can't drift
                     from what the build actually is. -->
                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>

                <!-- Right-docked, so the first declared sits furthest right. The
                     gap between two buttons is the right-hand one's LEFT margin,
                     so the leftmost carries none. -->
                <Button DockPanel.Dock="Right" Name="CloseButton" Content="Close"
                        Margin="12,0,0,0" Click="Close_Click"
                        ToolTip="Close the app"/>
                <Button DockPanel.Dock="Right" Name="CancelButton" Content="Cancel"
                        Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel_Click"
                        ToolTip="Stop the job after the archive it is on"/>
                <Button DockPanel.Dock="Right" Name="ExtractButton" Content="Extract"
                        Margin="6,0,0,0" Click="Extract_Click"
                        ToolTip="Find the matches and write them out"/>
                <Button DockPanel.Dock="Right" Name="ScanButton" Content="Scan"
                        Click="Scan_Click"
                        ToolTip="Find what matches, without writing anything"/>
            </DockPanel>
        </Border>

        <!-- Folders and options -->
        <Border Grid.Row="2" Padding="18,14,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Search in:"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Name="SearchBox" Margin="0,0,0,6"
                           TextChanged="SearchBox_TextChanged"
                           ToolTip="A folder of archives — usually the game install — or one .erp on its own."/>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource RowButton}" Content="Folder" Click="BrowseSearchFolder_Click"
                            ToolTip="Search a folder of archives"/>
                    <Button Style="{StaticResource RowButton}" Content="File" Click="BrowseSearchFile_Click"
                            ToolTip="Search one archive"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Output to:"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Name="OutputBox"
                           ToolTip="Where the extracted archives are written."/>
                <!-- Stretched because the column is sized by the two buttons
                     above, and a lone Auto-width button would sit against its
                     left edge with a gap after it. -->
                <Button    Grid.Row="1" Grid.Column="2" Style="{StaticResource RowButton}" Margin="6,0,0,0"
                           HorizontalAlignment="Stretch"
                           Content="Browse" Click="BrowseOutput_Click"/>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox Name="RecursiveCheck" Content="Search subfolders" IsChecked="True"
                              Margin="0,0,22,0"
                              ToolTip="Look in everything beneath the folder, not just the folder itself"/>
                    <CheckBox Name="StripCheck" Content="Strip mipmaps"
                              ToolTip="Pull each texture's full resolution in from the game's .mipmaps files, so the result stands on its own. Needs the game folder, which is in Settings."/>
                    <CheckBox Name="IndividualCheck" Content="Extract individually" Margin="22,0,0,0"
                              ToolTip="One archive per source, rather than everything merged into one"/>
                    <CheckBox Name="PrefixCheck" Content="Add folder name prefix" Margin="22,0,0,0"
                              ToolTip="Put the folder each archive came out of in front of its name, for telling apart archives called the same thing"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules on the left, what happened on the right.

             The buttons are a row of the outer grid rather than a bar docked
             inside the rules pane. Docked, they took their height out of the
             rules box alone and the log ran on 34px past its bottom edge; as a
             row, both panes end level and the buttons sit under the one they
             belong to. -->
        <Grid Grid.Row="3" Margin="18,4,18,12">
            <Grid.ColumnDefinitions>
                <!-- The minimum is the button row underneath, which measures
                     304px: a star column clips rather than refusing to shrink,
                     so at the old 240 dragging the divider left cut Import off
                     the end. A column cannot be allowed narrower than its own
                     controls. -->
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PaneHeading}" Text="RULES"/>
                    <TextBlock DockPanel.Dock="Right" Name="RulesCountLabel"
                               Style="{StaticResource PaneHeading}"/>
                </DockPanel>
                <!-- One border around the pair, so the gutter reads as part of
                     the editor rather than as a second control beside it. -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="RulesGutter" Grid.Column="0" Style="{StaticResource Gutter}"/>

                        <!-- A rule between the numbers and the text, the way an
                             editor draws one. Zero width until there is
                             something to separate. -->
                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                Background="{DynamicResource BorderSoft}"/>

                        <TextBox Name="RulesBox" Grid.Column="1" Margin="1,0,0,0"
                                 Style="{StaticResource BareEditor}"
                                 TextChanged="Rules_TextChanged" LostFocus="Rules_LostFocus"/>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Row 0 only. Spanning both rows ran the theme's divider line down
                 past the bottom of the two panes and alongside the buttons,
                 which belong to the left one.

                 The width is the spacing: the template centres a 1px line in
                 whatever room it is given, so 18 leaves the line clear of both
                 boxes and makes a bigger thing to grab at the same time. -->
            <GridSplitter Grid.Row="0" Grid.Column="1" Width="18"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Row="0" Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeading}" Text="LOG"/>
                <TextBox Name="LogBox" Style="{StaticResource Editor}" IsReadOnly="True"
                         Background="{DynamicResource SurfaceSunken}"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource RowButton}" Margin="0" Content="Reset"
                        Click="RulesReset_Click"
                        ToolTip="Put the list back to the worked example it starts as"/>
                <Button Style="{StaticResource RowButton}" Content="List from ERP"
                        Click="RulesFromErp_Click"
                        ToolTip="Add every resource in an archive to the list, one per line"/>
                <Button Style="{StaticResource RowButton}" Content="Export"
                        Click="RulesExport_Click"
                        ToolTip="Save the list to a text file"/>
                <Button Style="{StaticResource RowButton}" Content="Import"
                        Click="RulesImport_Click"
                        ToolTip="Replace the list with one from a text file"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock Name="StatusLabel" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Text="Point it at a folder or a single archive, write some rules, and press Scan."/>
        </Border>
    </Grid>
</Window>
