<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SimplifiedGridEditor.Core</RootNamespace>
    <AssemblyName>SimplifiedGridEditor.Core</AssemblyName>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    This app is the two editors in one window, so it takes their logic rather
    than a copy of it: the Team Editor's teams, language files, logos and
    packaging, and the Driver Swapper's seat plan and driver attributes. Both of
    those apps stay exactly as they are - this one only reads their Cores.

    The database reader itself is neither of theirs any more; it lives in
    EgoEngineLibrary and all three use it, which is what lets one project file
    carry edits from both halves of this window.
  -->
  <!-- The two resources the game wants in every mod that ships a shader
       package. One file in Shared, embedded by each packager that needs it;
       SerpsOverlay reads it back out. LogicalName is pinned so the lookup
       does not depend on this assembly's namespace. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\Shared\serps.erp" LogicalName="serps.erp" Condition="Exists('..\..\..\Shared\serps.erp')" />
    <Compile Include="..\..\..\Shared\SerpsOverlay.cs" Link="SerpsOverlay.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EGO Engine Library\EgoEngineLibrary.csproj" />
    <ProjectReference Include="..\..\..\Language Library\SimplifiedLanguage.csproj" />
    <ProjectReference Include="..\..\..\Simplified Team Editor\src\SimplifiedTeamEditor.Core\SimplifiedTeamEditor.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified Driver Swapper\src\SimplifiedDriverSwapper.Core\SimplifiedDriverSwapper.Core.csproj" />
  </ItemGroup>

</Project>
