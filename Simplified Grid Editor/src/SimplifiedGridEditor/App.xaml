<Application x:Class="SimplifiedGridEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimplifiedGridEditor"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The suite's look, from the shared library. The palette must
                     be merged FIRST and stay first: Theme.xaml resolves its
                     colours against whatever is already in the dictionary, and
                     ThemeManager swaps this entry in place when the theme
                     changes. This is the fallback, not the decision - App
                     applies the saved one at startup. -->
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Palette.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The app's own styles live here rather than on the window because
                 each tab is a UserControl: a window's resources are visible to
                 what it contains, but putting them here means a panel resolves
                 them the same way whether it is hosted in the window or opened
                 on its own.

                 Every keyed style says BasedOn. Without it the keyed style
                 replaces the themed template outright and drops that control
                 back to the stock Windows look, which stays light whatever the
                 palette says. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,3"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="10,0,0,6"/>
            </Style>

            <!-- The name fields on the Teams tab read as one table rather than as
                 separate boxes, so they lose their own chrome and take a divider
                 from the cell before them. -->
            <Style x:Key="CellInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- Rows the save will touch, so a glance at a table shows the work.
                 Hover and selection are template triggers and still win over
                 this, which is right: the row under the pointer should answer
                 the pointer. -->
            <Style x:Key="GridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
            </Style>

            <!-- The panel under a table, holding the editor for whatever is
                 selected. Sunken rather than outlined, so the table stays the
                 thing being looked at. -->
            <Style x:Key="EditorPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
