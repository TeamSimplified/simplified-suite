<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimplifiedGridEditor</RootNamespace>
    <AssemblyName>Simplified Grid Editor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Off deliberately. Turning it on embeds the native libraries in the
         single file, and the host then extracts them to %TEMP%\.net at startup:
         once per build, never cleaned up, and outside the app folder - which
         this app does not do. They publish as files instead, and
         MoveNativesIntoRuntimeFolder below tidies them away. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplifiedGridEditor.Core\SimplifiedGridEditor.Core.csproj" />
    <ProjectReference Include="..\..\..\Simplified UI Library\SimplifiedUi.csproj" />
  </ItemGroup>

  <!-- The other half of MoveNativesIntoRuntimeFolder below: nothing looks in a
       subfolder by default, so the app has to say where they went. Linked from
       Shared rather than copied, so every app resolves them the same way - and
       finds the game install the same way. -->
  <ItemGroup>
    <Compile Include="..\..\..\Shared\NativeLibraryFolder.cs" Link="NativeLibraryFolder.cs" />
    <Compile Include="..\..\..\Shared\GameDirDetector.cs" Link="GameDirDetector.cs" />
  </ItemGroup>

  <!-- Ship icon.ico loose next to the published EXE. Content items survive
       PublishSingleFile (None items get stripped); ExcludeFromSingleFile keeps
       them as separate files instead of embedded. -->
  <ItemGroup>
    <Content Include="..\..\icon.ico" Link="icon.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- texconv, which converts between PNG and the compressed forms a texture
       array holds. It goes in runtime\ beside the native libraries, which is
       where TexconvRunner looks for it. -->
  <ItemGroup>
    <Content Include="../../../Simplified Team Editor/tools/texconv.exe"
             Link="runtime/texconv.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <!-- The pristine game files every project is created from: the team database,
       the eleven language files, and the team-branding texarrays.

       Taken from the Team Editor's copy rather than a second one of our own.
       They are 90 MB, they are the same bytes, and two copies in the repository
       is two things to keep in step. This app already references that project,
       so the dependency is not a new one. -->
  <ItemGroup>
    <Content Include="..\..\..\Simplified Team Editor\original\**\*"
             Link="runtime\original\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"/>
  </ItemGroup>

  <Target Name="MoveNativesIntoRuntimeFolder" AfterTargets="Publish">
    <ItemGroup>
      <PublishedNativeLibrary Include="$(PublishDir)*.dll"/>
      <PublishedNativeLibrary Include="$(PublishDir)x64\*.dll"/>
      <UnusedArchitectureNative Include="$(PublishDir)x86\**\*"/>
    </ItemGroup>
    <Move SourceFiles="@(PublishedNativeLibrary)" DestinationFolder="$(PublishDir)runtime"/>
    <Delete Files="@(UnusedArchitectureNative)"/>
    <RemoveDir Directories="$(PublishDir)x64;$(PublishDir)x86"/>
  </Target>

</Project>
