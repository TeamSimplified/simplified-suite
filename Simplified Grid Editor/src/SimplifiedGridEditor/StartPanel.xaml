<UserControl x:Class="SimplifiedGridEditor.StartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="2,0,2,12" TextWrapping="Wrap"
                   Text="The three drivers standing on the game's start screen, in the order they appear. The choices are the drivers on the 2026 grid, so a swap made on the Grid tab shows up here straight away."/>

        <Border Grid.Row="1" Style="{StaticResource EditorPanel}">
            <StackPanel>
                <TextBlock Name="StartUnavailableLabel" Visibility="Collapsed"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="This project's database doesn't hold the start-screen records, so there is nothing to change here."/>

                <Grid Name="SlotGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Name="StartResetAllButton" Content="Reset all three"
                            IsEnabled="False" Click="StartResetAll_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
