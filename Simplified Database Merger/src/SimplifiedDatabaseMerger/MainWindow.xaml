<Window x:Class="SimplifiedDatabaseMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:SimplifiedDatabaseMerger.Core;assembly=SimplifiedDatabaseMerger.Core"
        xmlns:local="clr-namespace:SimplifiedDatabaseMerger"
        Title="Simplified Database Merger"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Background="{DynamicResource Surface}">

    <!-- Our own title bar, but still a real window: WindowChrome keeps the
         native resize borders, snapping, Aero Snap layouts and double-click to
         maximise, which WindowStyle=None + AllowsTransparency would all throw
         away. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <x:Array x:Key="KeepChoices" Type="core:Keep">
            <core:Keep>First</core:Keep>
            <core:Keep>Second</core:Keep>
            <core:Keep>Clean</core:Keep>
        </x:Array>

        <!-- A value column that steps forward when it is the one being kept
             and back when it is not, so a glance down the grid says what the
             merged file will hold without reading the Keep column. -->
        <Style x:Key="ValueCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Height="56" Padding="28,0,14,0">
            <DockPanel LastChildFill="False">
                <!-- The wordmark, from the shared library. The margin puts the
                     letters back on the name's baseline: the mark's box carries
                     the descender of its "p". -->
                <Viewbox DockPanel.Dock="Left" Height="17" VerticalAlignment="Center" Stretch="Uniform"
                         Margin="0,1,0,0">
                    <Path Data="{DynamicResource BrandWord}" Fill="{DynamicResource BrandInk}"/>
                </Viewbox>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Database Merger"/>

                <Border DockPanel.Dock="Left" Background="{DynamicResource Badge}" CornerRadius="3"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Name="VersionLabel" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Border>

                <Border DockPanel.Dock="Left" Width="1" Height="22" Margin="16,0,0,0"
                        VerticalAlignment="Center" Background="{DynamicResource BorderSoft}"/>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextMuted}"
                           Text="Two edited databases, one clean one, every change in a fresh copy"/>

                <!-- Reverse visual order, as DockPanel resolves Dock=Right outward-in. -->
                <Button DockPanel.Dock="Right" Name="WindowCloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="WindowClose_Click" ToolTip="Close"/>
                <Button DockPanel.Dock="Right" Name="WindowMaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="WindowMaximize_Click" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Name="WindowMinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="WindowMinimize_Click" ToolTip="Minimize"/>
            </DockPanel>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Name="SettingsButton" Style="{StaticResource IconButton}"
                        Tag="{StaticResource IconSettings}" Click="Settings_Click"
                        ToolTip="Settings"/>
                <!-- Always Save As: the merged file is new every time, and the
                     one place it must never land by accident is over one of
                     the three it was made from. -->
                <Button DockPanel.Dock="Right" Name="MergeButton" Content="Save merged database"
                        Padding="12,7" FontWeight="SemiBold" IsEnabled="False" Click="Save_Click"
                        ToolTip="Write a fresh copy of the clean database with every change from both (Ctrl+Shift+S)"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="18,14,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The three inputs. Each row takes a dropped file as well as a
                 browsed one; a drop anywhere else goes to the first empty row. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Clean database" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Tag="0" AllowDrop="True" Drop="Slot_Drop">
                    <TextBox Name="CleanBox" IsReadOnly="True"
                             ToolTip="The unedited database both mods were made from"/>
                    <TextBlock Name="CleanInfo" Margin="2,4,0,10" Foreground="{DynamicResource TextMuted}"
                               Text="The unedited database both mods were made from - .bin, or a zip with one inside"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="From game" Padding="12,7" Margin="8,0,0,0" Click="FromGame_Click"
                            Name="FromGameButton"
                            ToolTip="Use the database in the game folder set in Settings"/>
                    <Button Content="Browse" Padding="12,7" Margin="6,0,0,0" Tag="0" Click="Browse_Click"
                            Name="BrowseCleanButton"/>
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="0" Content="First database" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Tag="1" AllowDrop="True" Drop="Slot_Drop">
                    <TextBox Name="FirstBox" IsReadOnly="True" ToolTip="An edited database"/>
                    <TextBlock Name="FirstInfo" Margin="2,4,0,10" Foreground="{DynamicResource TextMuted}"
                               Text="An edited database - .bin, or a mod's zip"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse" Padding="12,7" Margin="8,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Tag="1" Click="Browse_Click"
                        Name="BrowseFirstButton"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Second database" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Tag="2" AllowDrop="True" Drop="Slot_Drop">
                    <TextBox Name="SecondBox" IsReadOnly="True" ToolTip="Another edited database"/>
                    <TextBlock Name="SecondInfo" Margin="2,4,0,10" Foreground="{DynamicResource TextMuted}"
                               Text="Another edited database - .bin, or a mod's zip"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse" Padding="12,7" Margin="8,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Tag="2" Click="Browse_Click"
                        Name="BrowseSecondButton"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,4,0,12" Background="{DynamicResource BorderSoft}"/>

            <!-- What the merge found, and the three ways to settle every
                 conflict at once. -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Name="AllPanel" Visibility="Collapsed">
                    <TextBlock Text="Keep for all:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextMuted}"/>
                    <Button Content="First" Padding="12,5" Tag="First" Click="KeepAll_Click"/>
                    <Button Content="Second" Padding="12,5" Margin="6,0,0,0" Tag="Second" Click="KeepAll_Click"/>
                    <Button Content="Clean" Padding="12,5" Margin="6,0,0,0" Tag="Clean" Click="KeepAll_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Name="SummaryHeadline" Style="{StaticResource SectionHeader}"
                               Text="Choose the three databases"/>
                    <TextBlock Name="SummaryDetail" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="The clean one, then the two edited ones. Every change either of them made is put into a fresh copy of the clean one; where both changed the same record differently, you choose."/>
                </StackPanel>
            </DockPanel>

            <!-- What the merge found, three ways: the records the two
                 disagree on, and everything each one changed on its own, each
                 against the clean database. The change tabs say what becomes
                 of every change, conflicts included, so either mod can be
                 checked for something that went missing. -->
            <TabControl Grid.Row="3" Name="ResultTabs" Visibility="Collapsed"
                        SelectionChanged="ResultTabs_SelectionChanged">
                <TabItem Name="ConflictsTab" Header="Conflicts">
                    <Grid>
                        <DataGrid Name="ConflictGrid" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Record" Binding="{Binding KeyText}" IsReadOnly="True" Width="150"
                                                    FontFamily="Consolas, Cascadia Mono"/>
                                <DataGridTemplateColumn Header="Clean" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="local:ConflictRow">
                                            <TextBlock Text="{Binding CleanText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueCell}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Keep}" Value="Clean">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="First" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="local:ConflictRow">
                                            <TextBlock Text="{Binding FirstText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueCell}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Keep}" Value="First">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Second" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="local:ConflictRow">
                                            <TextBlock Text="{Binding SecondText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ValueCell}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Keep}" Value="Second">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Keep" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="local:ConflictRow">
                                            <ComboBox ItemsSource="{StaticResource KeepChoices}" Margin="2"
                                                      SelectedItem="{Binding Keep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Name="NoConflictsNote" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" FontSize="14" TextAlignment="Center"
                                   Visibility="Collapsed" Text="No conflicts - nothing to choose."/>
                    </Grid>
                </TabItem>
                <TabItem Name="FirstTab" Header="First database">
                    <DataGrid Name="FirstGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record" Binding="{Binding KeyText}" Width="150"
                                                FontFamily="Consolas, Cascadia Mono"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding KindText}" Width="90"/>
                            <DataGridTextColumn Header="Clean" Binding="{Binding CleanText}" Width="*"/>
                            <DataGridTextColumn Header="First" Binding="{Binding EditedText}" Width="*"/>
                            <DataGridTextColumn Header="In the merge" Binding="{Binding MergeText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Name="SecondTab" Header="Second database">
                    <DataGrid Name="SecondGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record" Binding="{Binding KeyText}" Width="150"
                                                FontFamily="Consolas, Cascadia Mono"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding KindText}" Width="90"/>
                            <DataGridTextColumn Header="Clean" Binding="{Binding CleanText}" Width="*"/>
                            <DataGridTextColumn Header="Second" Binding="{Binding EditedText}" Width="*"/>
                            <DataGridTextColumn Header="In the merge" Binding="{Binding MergeText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="3" Name="EmptyNote" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" FontSize="14" TextAlignment="Center"
                       Text="Drop databases on the rows above, or browse to them."/>
        </Grid>
    </Grid>
</Window>
