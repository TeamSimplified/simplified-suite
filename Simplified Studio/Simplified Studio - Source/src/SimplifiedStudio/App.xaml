<Application x:Class="SimplifiedStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimplifiedStudio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The starting palette. ThemeManager swaps this entry at startup
                     for whatever the user last chose, and again whenever they
                     change it in Settings — so this is the fallback, not the
                     decision.

                     Palette.Light.xaml / Palette.Dark.xaml / Palette.Glass.xaml.
                     Glass also needs the DWM backdrop code, which neither app
                     carries any more — the ui-full-glass tag holds both halves.

                     The palette must be merged FIRST: Theme.xaml resolves its
                     colours with StaticResource, which only sees what is already
                     in the dictionary. -->
                <ResourceDictionary Source="Palette.Light.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
