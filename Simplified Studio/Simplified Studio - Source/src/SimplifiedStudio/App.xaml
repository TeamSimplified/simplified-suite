<Application x:Class="SimplifiedStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimplifiedStudio"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The look is a library now: the palette and the styles come from
                     SimplifiedUi, and only the wordmark below is this app's own.

                     The palette must be merged FIRST and stay first: Theme.xaml
                     resolves its colours against whatever is already in the
                     dictionary, and ThemeManager swaps this entry in place when
                     the theme changes. This is the fallback, not the decision -
                     ThemeManager applies the saved one at startup. -->
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Palette.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SimplifiedUi;component/Theme.xaml"/>
                <ResourceDictionary Source="Brand.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
