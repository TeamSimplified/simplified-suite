<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NefsLib, from EgoEngineModding/ego.nefsedit, vendored - MIT, (c) victorbush.
    LICENSE beside this file is theirs, kept verbatim.

    Here because the game keeps its language files inside F1_25.exe, in an
    embedded NeFS archive, and nothing else in the suite can read one. Their
    0.7.1 added the whole-exe header search that newer F1 titles need, which is
    the part that makes this work at all.

    Vendored rather than referenced as a package: this is what the suite already
    does with EgoEngineLibrary, and for the same reason - the format work is the
    dependency, and having the source means a fix does not wait on somebody
    else's release. Namespaces are unchanged (VictorBush.Ego.NefsLib.*) so the
    code reads as theirs, and an update is a copy over the top.

    Changed from their csproj: net8.0 to net10.0, so the suite is one framework;
    and their InternalsVisibleTo entries for test projects are dropped, because
    the tests did not come across.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VictorBush.Ego.NefsLib</RootNamespace>
    <AssemblyName>VictorBush.Ego.NefsLib</AssemblyName>
    <!-- Theirs, not ours. Keeps the DLL honest about where it came from. -->
    <Company>victorbush</Company>
    <Copyright>NefsLib (MIT), (c) victorbush - github.com/EgoEngineModding/ego.nefsedit</Copyright>
    <Version>0.7.1</Version>
    <!-- Their code, their warnings: this is carried, not maintained, and a
         wall of warnings from it would drown out ours. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1062;CA1031;CA2022;CA2265;IDE0290</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

</Project>
